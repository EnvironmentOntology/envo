        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ozone layer</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.eionet.europa.eu/gemet/concept/5993</oboInOwl:hasDbXref>
    </owl:Axiom>
    


