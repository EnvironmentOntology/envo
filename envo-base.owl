        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-15T04:00:01.750Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">pliofilm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Synthetic plastic which is composed of a glossy, moistureproof membrane made of rubber hydrochloride.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/Pliofilm"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03501306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26178"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A polyester film made from stretched polyethylene terephthalate (PET).</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-15T04:00:01.750Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym xml:lang="en">BoPET (Biaxially-oriented polyethylene terephthalate)</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mylar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
