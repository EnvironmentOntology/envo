        <oboInOwl:hasExactSynonym>quantum chromodynamics binding energy</oboInOwl:hasExactSynonym>
        <rdfs:label>chromodynamic energy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Potential energy due to the energy of the gluon-mediated field of the strong force, binding quarks together into hadrons.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Quantum_chromodynamics_binding_energy"/>
    </owl:Axiom>
    


