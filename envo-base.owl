                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000856"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
