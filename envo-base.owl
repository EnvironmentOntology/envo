            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A geographic basin which is formed due to the erosion of thermokarst by meltwater released from thawing permafrost.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
