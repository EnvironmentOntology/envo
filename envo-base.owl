        <obo:IAO_0000115 xml:lang="en">A piece of rock which has a grain size between 64 and 256 mm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:cobble</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Cobble</oboInOwl:hasDbXref>
