            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A glacier which is contained in the site bounded by a volcanic crater.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>crater glacier</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">volcanic crater glacier</rdfs:label>
    </owl:Class>
    


