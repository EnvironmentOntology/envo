        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000281"/>
        <obo:IAO_0000115>A layer throughout which one or more qualities (e.g. pressure, temperature, velocity, density) maintain an approximately constant value.</obo:IAO_0000115>
        <rdfs:comment>Isosurfaces are not equivalent to a &quot;surface layer&quot; in the sense of overlapping an external boundary. Further, this class is concerned only with material isosurfaces, not with mathematical abstractions.</rdfs:comment>
        <rdfs:label xml:lang="en">material isosurface</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001274"/>
