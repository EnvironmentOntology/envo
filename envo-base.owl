    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000291"/>
        <obo:IAO_0000115>A drainage basin from which there is no outflow of water, either on the surface as rivers, or underground by flow or diffusion through rock or permeable material.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:endorheic_basin</oboInOwl:hasDbXref>
