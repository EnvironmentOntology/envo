        <rdfs:label xml:lang="en">concentration of carbon dioxide in an atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001866 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001866">
