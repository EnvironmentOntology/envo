    <!-- http://purl.obolibrary.org/obo/ENVO_02000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000127"/>
        <obo:IAO_0000115>a coarse, angular ash particle that is too large to be carried up into the smoke stacks so it forms in the bottom of the coal furnace.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bottom ash</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000129"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
