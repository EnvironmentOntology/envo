        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-05T17:34:16Z</dc:date>
        <rdfs:label xml:lang="en">active enrichment culturing unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001823 -->

