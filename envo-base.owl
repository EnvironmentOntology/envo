        <oboInOwl:hasDbXref>FTT:1074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:T.SINK</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Sink</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21371</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Sinkhole</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cenote</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sink</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605014"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605018"/>
        <rdfs:label>sinkhole</rdfs:label>
    </owl:Class>
