            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A tundra ecosystem which is undergoing climactic ecological succession.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-07T14:26:46Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>SPIRE:Tundra</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605013"/>
