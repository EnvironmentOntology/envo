            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A secondary mineral deposit formed in caves, most commonly calcite.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:speleothem</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Speleothem</oboInOwl:hasDbXref>
