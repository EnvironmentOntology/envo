            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The tide zone that is flooded during high tide only, and is a highly saline environment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>upper littoral</oboInOwl:hasRelatedSynonym>
        <rdfs:label>high tide zone</rdfs:label>
    </owl:Class>
