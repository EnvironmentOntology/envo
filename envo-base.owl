        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115>A smooth, durable vitreous coating which is made by fusing powdered glass to a substrate.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-7463-6306"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T18:18:43Z</dc:date>
        <oboInOwl:hasExactSynonym>porcelain enamel</oboInOwl:hasExactSynonym>
        <rdfs:comment>Enamel can be used on metal, glass, ceramics, stone, or any material able to withstand the fusing temperature. Enamel is made by 1) firing, melting the powder and 2) allowing allowing it to flow across a surface to then harden.</rdfs:comment>
        <rdfs:label xml:lang="en">vitreous enamel</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03510030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A smooth, durable vitreous coating which is made by fusing powdered glass to a substrate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Vitreous_enamel</oboInOwl:hasDbXref>
    </owl:Axiom>
    


