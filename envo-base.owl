        <oboInOwl:hasRelatedSynonym>pelagic sediment {alternative name}</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ENVO:00002113</oboInOwl:id>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>deep marine sediment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002113"/>
