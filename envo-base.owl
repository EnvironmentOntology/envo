        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
