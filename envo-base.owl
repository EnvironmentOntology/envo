        <obo:IAO_0000115>Rock formed from molten magma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:igneous_rock</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:IgneousRock</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Igneous_rock</oboInOwl:hasDbXref>
        <rdfs:label>igneous rock</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002013"/>
