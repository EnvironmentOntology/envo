    <!-- http://purl.obolibrary.org/obo/ENVO_01001512 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002200"/>
