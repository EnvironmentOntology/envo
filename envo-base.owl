    <!-- http://purl.obolibrary.org/obo/ENVO_03600044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000078"/>
        <obo:IAO_0000115 xml:lang="en">A farm which is managed using practices certified to be organic by a competent authority.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-24T03:53:29.138Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">What qualifies as an organic farm varies significantly across nations and subnational entities. In general, however, organic farming involves the use of biological pest control, mixed cropping, natural fertilisers, and the fostering of insect predators. Further, organic certification often requires that synthetic pesticides and fertilisers are not used.</rdfs:comment>
        <rdfs:label xml:lang="en">organic farm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A farm which is managed using practices certified to be organic by a competent authority.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Organic_farming"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">What qualifies as an organic farm varies significantly across nations and subnational entities. In general, however, organic farming involves the use of biological pest control, mixed cropping, natural fertilisers, and the fostering of insect predators. Further, organic certification often requires that synthetic pesticides and fertilisers are not used.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Organic_farming"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03600045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115 xml:lang="en">A manufactured product which is designed to function as a container for growing plants.</obo:IAO_0000115>
