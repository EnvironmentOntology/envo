        <oboInOwl:hasDbXref rdf:resource="https://www.britannica.com/science/weathering-geology"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
