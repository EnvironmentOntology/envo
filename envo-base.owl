                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000318"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thermokarst lake through which methane gas released from thawing permafrost, or other methane stores, rises and escapes to the atmosphere.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>On Earth, the bright blue appearance, in the light spectrum visible to humans, is due to increased abundances of microorganisms attracted to sulfur compounds associated with the methane release.</rdfs:comment>
        <rdfs:label xml:lang="en">methane-releasing thermokarst lake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A thermokarst lake through which methane gas released from thawing permafrost, or other methane stores, rises and escapes to the atmosphere.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.sciencealert.com/photos-reveal-more-than-200-bright-blue-arctic-lakes-have-started-bubbling-with-methane-gas</oboInOwl:hasDbXref>
    </owl:Axiom>
    


