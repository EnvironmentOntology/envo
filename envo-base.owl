    <!-- http://purl.obolibrary.org/obo/ENVO_00000398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001688"/>
