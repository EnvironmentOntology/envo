    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001669"/>
        <obo:IAO_0000115>A mariculture process during which organisms are cultivated in cages which allow the passage of materials such as wastes, pathogens, antibiotics, and - should a containment breach occur - cultivated organisms themselves to and from the surrounding marine environment.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-15T22:00:48Z</dc:date>
        <rdfs:label xml:lang="en">open cage mariculture process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mariculture process during which organisms are cultivated in cages which allow the passage of materials such as wastes, pathogens, antibiotics, and - should a containment breach occur - cultivated organisms themselves to and from the surrounding marine environment.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://www.foodandwaterwatch.org/sites/default/files/fs_1802_ocean-aquaculture-web.pdf"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.tranaquaculture.com/"/>
    </owl:Axiom>
    


