            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A desert ecosystem which is undergoing climactic ecological succession.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-07T14:26:46Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>SPIRE:Desert_or_dune</oboInOwl:hasDbXref>
        <oboInOwl:inSubset>wwfBiome</oboInOwl:inSubset>
        <rdfs:label>desert biome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000180">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001370"/>
