        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000488"/>
        <obo:IAO_0000115>A lake, part of whose margin is formed by an ice mass, ice cap or glacier, the ice having obstructed the natural drainage of the land.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Periglacial_lake</oboInOwl:hasDbXref>
