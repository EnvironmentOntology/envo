        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A gaseous surface layer which is composed of the warmer air mass(es) along the horizontal density and temperature discontinuity in a weather front.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-20T08:25:43Z</dc:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">frontal surface</oboInOwl:hasBroadSynonym>
        <rdfs:comment xml:lang="en">As stated in the AMS Glossary, this is one interpretation of the term &quot;front&quot;, namely &quot;frontal surfaces across which the horizontal density gradient is discontinuous (frontal surface usually refers specifically to the warmer side of the frontal zone);&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">frontal surface of a weather front</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A gaseous surface layer which is composed of the warmer air mass(es) along the horizontal density and temperature discontinuity in a weather front.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Front"/>
    </owl:Axiom>
    


