    <!-- http://purl.obolibrary.org/obo/ENVO_03600078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003861"/>
        <obo:IAO_0000115 xml:lang="en">An industrial building in which crude oil is transformed and refined into useful products.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-03T00:22:16.764Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">The useful products include petroleum naphtha, gasoline, diesel fuel, asphalt base, heating oil, kerosene, liquefied petroleum gas, jet fuel and fuel oils. Oil refineries are typically large, sprawling industrial complexes with extensive piping running throughout, carrying streams of fluids between large chemical processing units, such as distillation columns.</rdfs:comment>
        <rdfs:label xml:lang="en">oil refinery</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
