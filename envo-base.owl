            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake which fills a depression where drainage is blocked by solid material transported by a landslide.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">landslide lake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001106"/>
