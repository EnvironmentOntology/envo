            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A pond which is 1) shallow, 2) man-made, and 3) designed to produce salt from seawater through evaporation.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>lake</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FTT:221</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:906</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:H.MFGN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:H.PNDN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:H.PNDSN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Salt_evaporation_pond</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>salt evaporation pond</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>salt pond</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>salt ponds</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>saltern</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605018"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605025"/>
        <rdfs:comment xml:lang="en">In such ponds, water is drawn out of seawater through natural evaporation which allows the salt to be subsequently harvested.</rdfs:comment>
        <rdfs:label>saline evaporation pond</rdfs:label>
    </owl:Class>
