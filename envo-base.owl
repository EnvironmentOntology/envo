        <owl:annotatedTarget>A water flow process during which water flows out of an aquifer.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Groundwater_discharge</oboInOwl:hasDbXref>
    </owl:Axiom>
    


