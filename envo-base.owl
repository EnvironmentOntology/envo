            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A protoplanetary disk which is externally illuminated and undergoing photoevaporation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ionized protoplanetary disk</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">proplyd</rdfs:label>
