                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A marine environment and enviroment which is determined by a marine water body.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>marine environment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A marine environment and enviroment which is determined by a marine water body.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NM:nm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000321 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000321">
