        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001792"/>
        <obo:IAO_0000115>A tropical broadleaf forest which 1) has low variability in annual temperature, 2) high levels of rainfall (&gt;200 centimeter annually), and 3) has tree communities dominated by semi-evergreen and evergreen species.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-27T16:17:13Z</dc:date>
        <rdfs:label xml:lang="en">tropical moist broadleaf forest</rdfs:label>
    </owl:Class>
