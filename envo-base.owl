        <obo:IAO_0000115>An ecosystem which overlaps those areas of the foreshore and seabed that are exposed to the air at low tide and submerged at high tide.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:hasBroadSynonym>coastal zone</oboInOwl:hasBroadSynonym>
