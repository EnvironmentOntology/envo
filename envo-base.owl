        <obo:IAO_0000115>A hillside is a slope that is part of a hill.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>brae</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hillside</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000334">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
