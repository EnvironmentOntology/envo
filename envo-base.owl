        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A planned process during which a soil profile is examined and the soil horizons that compose it are described.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.ctahr.hawaii.edu/mauisoil/a_profile.aspx</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105268 -->

