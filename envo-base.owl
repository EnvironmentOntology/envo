        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000776"/>
        <obo:IAO_0000115 xml:lang="en">A piece of plastic which is flexible, thin, and planar.</obo:IAO_0000115>
