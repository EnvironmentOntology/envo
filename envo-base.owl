        <rdfs:label>oceanic pelagic zone biome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The oceanic epipelagic zone biome comprises the marine water column offshore, beyond a continental shelf.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:978-0-444-82619-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:978-0-7506-3384-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORCID:0000-0002-4366-3088</oboInOwl:hasDbXref>
