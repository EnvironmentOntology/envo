        <rdfs:comment>QCR: &apos;contains process&apos; min 2 &apos;environmental system process&apos;</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
