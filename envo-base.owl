    <!-- http://purl.obolibrary.org/obo/ENVO_01000653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000658"/>
        <rdfs:subClassOf>
