    <!-- http://purl.obolibrary.org/obo/ENVO_01001448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001436"/>
        <obo:IAO_0000115>A planned environmental usage process during which an environment supports the sale of goods to ultimate consumers, usually in small quantities.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <rdfs:comment>This class includes activities carried out in shops, showrooms, cafes, travel agents, hairdressers, facilities providing financial and professional services, restaurants, public houses, and bars.</rdfs:comment>
        <rdfs:label xml:lang="en">usage of an environment for retail activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
