    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00009003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A habitat that is in or on a living animal. Here &quot;animal&quot; denotes an individual of a species that is a sub-taxon of NCBITaxon:9606.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00009004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00009004">
        <obo:IAO_0000115>A habitat that is in or on a living insect. Here &quot;insect&quot; denotes an individual of a species that is a sub-taxon of NCBITaxon:50557.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
