    <!-- http://purl.obolibrary.org/obo/ENVO_01000299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001479"/>
