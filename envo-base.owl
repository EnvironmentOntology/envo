        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Peatland#Types_of_peatland</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000189 -->

