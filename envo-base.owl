        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000314"/>
        <obo:IAO_0000115>A convergence of neighboring alluvial fans into a single apron of deposits against a slope.</obo:IAO_0000115>
