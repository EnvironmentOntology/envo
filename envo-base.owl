        <oboInOwl:hasDbXref>FTT:240</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:501</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>LTER:941</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SPIRE:Intertidal</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:IntertidalZone</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Intertidal_zone</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>IntertidalZone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>littoral zone</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These semantics link with those of environmental zones. Use this class to refer to the ecosystem rather than the area that it occupies.</rdfs:comment>
        <rdfs:label xml:lang="en">intertidal ecosystem</rdfs:label>
    </owl:Class>
