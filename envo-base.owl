    <!-- http://purl.obolibrary.org/obo/ENVO_00000465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000463"/>
        <obo:IAO_0000115>A harbor which is formed by a natural landform where a part of a body of water is protected and deep enough to furnish anchorage.</obo:IAO_0000115>
