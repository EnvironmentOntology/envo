    <!-- http://purl.obolibrary.org/obo/ENVO_00000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001092"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001095"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake which fills a depression that has formed as a result of subsidence along a a rift zone, an area of extensional tectonics in the continental crust.</obo:IAO_0000115>
