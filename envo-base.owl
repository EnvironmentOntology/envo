    <!-- http://purl.obolibrary.org/obo/ENVO_01001422 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001160"/>
        <obo:IAO_0000115>A cirrus cloud which 1) is structurally organised in patches, 2) is sufficiently dense to appear greyish when viewed towards the local star and 3) may veil, the local star, obscure its outline, or even hide it entirely.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
        <rdfs:comment>Cirrus spissatus often originates from the upper part of a Cumulonimbus.</rdfs:comment>
        <rdfs:label xml:lang="en">cirrus spissatus cloud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001422"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
