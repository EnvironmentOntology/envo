            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental material primarily composed of dihydrogen oxide in its liquid form.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>water</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EcoLexicon:water</oboInOwl:hasDbXref>
