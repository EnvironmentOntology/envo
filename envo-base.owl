        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>The definition in the GCW assessment notes that the depth of snow or ice must be of &quot;a substantial depth&quot;. This is in need of specification. When the thickness become great enough, tongues of ice overflow the basins or plateaus as Valley Glaciers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0003-4808-4736</oboInOwl:hasDbXref>
    </owl:Axiom>
    


