        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T09:12:35Z</dc:date>
        <oboInOwl:hasDbXref rdf:resource="http://aims.fao.org/aos/agrovoc/c_5998"/>
        <oboInOwl:hasDbXref rdf:resource="http://eurovoc.europa.eu/1837"/>
        <oboInOwl:hasExactSynonym xml:lang="en">manufactured plastic</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoPlastics</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">synthetic plastic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001436"/>
        <obo:IAO_0000115 xml:lang="en">A planned environmental usage process during which any number of fish are caught by humans or their technologies.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T17:56:06Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">angeln</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">fischen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">pesca</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">pesca</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset xml:lang="en">envoPlastics</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">fishing</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105113"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A planned environmental usage process during which any number of fish are caught by humans or their technologies.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Fishing"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.lexico.com/definition/fishing"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002608"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105115"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An anthropogenic environmental process during which abandoned, lost, or discarded fishing gear attracts and entangles organisms.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">While not driven by humans directly, ghost fishing is a downstream result of their intentional actions.</obo:IAO_0000116>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T18:00:11Z</dc:date>
        <oboInOwl:inSubset>envoPlastics</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">ghost fishing</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105114"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An anthropogenic environmental process during which abandoned, lost, or discarded fishing gear attracts and entangles organisms.</owl:annotatedTarget>
        <rdfs:comment rdf:resource="http://www.gesamp.org/publications/guidelines-for-the-monitoring-and-assessment-of-plastic-litter-in-the-ocean"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002331"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105113"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A manufactured product which is used for fishing.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T18:01:58Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">Angelausrüstung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Angelzubehör</oboInOwl:hasExactSynonym>
