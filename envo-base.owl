    <!-- http://purl.obolibrary.org/obo/ENVO_00000262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000106"/>
        <obo:IAO_0000115>A plain without trees (apart from those near rivers and lakes); it is similar to a prairie, although a prairie is generally considered as being dominated by tall grasses, while short grasses are said to be normal in the steppe. It may be semi-desert, or covered with grass or shrubs or both, depending on the season and latitude.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:steppe</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Steppe</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>grassland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pampa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pampas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>puszta</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605014"/>
        <rdfs:label>steppe</rdfs:label>
    </owl:Class>
