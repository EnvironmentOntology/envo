        <obo:IAO_0000115>A tropical broadleaf forest which 1) s subject to a year-round warm climate 2) may receive several hundred centimeters or rain per year and 3) are subject to long dry seasons which last several months.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-27T16:16:37Z</dc:date>
