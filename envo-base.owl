        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A harbor constructed by human agency.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MA:ma</oboInOwl:hasDbXref>
