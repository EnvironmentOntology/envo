    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001201"/>
