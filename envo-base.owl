        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Atmospheric_escape</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001157"/>
