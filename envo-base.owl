    <!-- http://purl.obolibrary.org/obo/envo#disconnected_from -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/envo#disconnected_from">
        <obo:IAO_0000115>A is disconnected_from B if they have no parts in common.</obo:IAO_0000115>
        <obo:IAO_0000425>Class: &lt;http://www.w3.org/2002/07/owl#Nothing&gt; EquivalentTo: (BFO_0000050 some ?X) and (BFO_0000050 some ?Y)</obo:IAO_0000425>
        <oboInOwl:hasExactSynonym>non_overlapping_with</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>disconnected_from</oboInOwl:id>
        <oboInOwl:is_class_level rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</oboInOwl:is_class_level>
        <oboInOwl:is_metadata_tag rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</oboInOwl:is_metadata_tag>
        <rdfs:label>disconnected_from</rdfs:label>
    </owl:AnnotationProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/envo#disconnected_from"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A is disconnected_from B if they have no parts in common.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    </owl:Axiom>
    


