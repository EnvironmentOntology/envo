        <oboInOwl:hasExactSynonym>take-away</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">take-out restaurant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000972"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A restaurant which provides prepared meals or other food products that the purchaser must eat off its premises.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Restaurant</oboInOwl:hasDbXref>
        <rdfs:comment>http://orcid.org/0000-0002-8844-9165</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000973 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001222"/>
