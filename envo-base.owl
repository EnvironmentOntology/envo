    <!-- http://purl.obolibrary.org/obo/ENVO_00002014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002013"/>
        <obo:IAO_0000115>An igneous rock that results from the crystallization of a magma below the surface of the Earth.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SWEETRealm:IntrusiveRock</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Plutonic_rock</oboInOwl:hasDbXref>
