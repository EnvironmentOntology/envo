    <!-- http://purl.obolibrary.org/obo/ENVO_00000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000086"/>
        <obo:IAO_0000115>A plain where a stream meanders across an area with a very low gradient, usually with a fairly continuous discharge. In addition to meanders, scroll plains are also characterised by many oxbow lakes.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00000253</oboInOwl:id>
