        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment xml:lang="en">On Earth, continental margins constitute about 28% of the oceanic area.</rdfs:comment>
        <rdfs:label>continental margin</rdfs:label>
    </owl:Class>
