        <oboInOwl:hasDbXref>http://encyclopedia2.thefreedictionary.com/Intermittent+stream</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000981 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000981">
