        <oboInOwl:id>ENVO:01000100</oboInOwl:id>
        <rdfs:label>along-front current</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000100"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A marine surface current that flows along an oceanic front.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ORCID:0000-0002-4366-3088</oboInOwl:hasDbXref>
    </owl:Axiom>
    


