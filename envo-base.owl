        <obo:IAO_0000115>New ice, which is spongy, lumpy and opaque, and forms from water which freezes in an agitated water body.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
