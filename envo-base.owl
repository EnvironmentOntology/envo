        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000100"/>
        <obo:IAO_0000115>A valley that contains, or contained, a glacier and was formed by glacial activity. Typically U-shaped in cross-section.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Glacial_valley</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
