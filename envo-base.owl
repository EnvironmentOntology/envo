    <!-- http://purl.obolibrary.org/obo/ENVO_00000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
