            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A climate which is realised through hydrological processes.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">hydroclimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
