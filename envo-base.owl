    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02500021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02500021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001795"/>
        <rdfs:subClassOf>
            <owl:Restriction>
