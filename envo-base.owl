            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cloud which is cirriform and is formed by condensation events centred on an aircraft&apos;s contrail.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">cirrus homogenitus cloud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cloud which is cirriform and is formed by condensation events centred on an aircraft&apos;s contrail.</owl:annotatedTarget>
