        <owl:annotatedTarget>An ice calving process during which a mass of ice falls from a larger mass onto land.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001658 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001658">
