            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001428"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500027"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001428"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cloud which is formed by condensation events triggered by some anthropogenic processes or the outputs thereof, such as aircraft contrails or emissions from chimneys.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">homogenitus cloud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001415"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
