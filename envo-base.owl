            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An ash fall process is a process in which volcanic ash formed during an explosive volcanic eruption, phreatomagmatic eruption, or during material transport in pyroclastic density currents is pulled towards the planetary surface by gravity.</obo:IAO_0000115>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">ash fall process</rdfs:label>
