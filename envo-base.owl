        <oboInOwl:hasExactSynonym>rock powder</oboInOwl:hasExactSynonym>
        <rdfs:comment>Rock dust is widely used in mining to prevent coal dust explosions, or in agriculture for organic farming uses.</rdfs:comment>
        <rdfs:label xml:lang="en">rock dust</rdfs:label>
