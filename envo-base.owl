    <!-- http://purl.obolibrary.org/obo/ENVO_00000340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003002"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000017"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003004"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000017"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000017"/>
        <obo:IAO_0000115 xml:lang="en">A particle which 1) is composed primarily of and derived from rock or mineral sources and 2) is or was part of a portion of sand.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">grain of sand</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">granule of sand</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sand granule</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">In general, sand grains are larger than those of silt, but finer than those of gravel.</rdfs:comment>
        <rdfs:label xml:lang="en">particle of sand</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000340"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A particle which 1) is composed primarily of and derived from rock or mineral sources and 2) is or was part of a portion of sand.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Sand"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000339"/>
