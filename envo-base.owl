    <!-- http://purl.obolibrary.org/obo/ENVO_03500005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03500005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
