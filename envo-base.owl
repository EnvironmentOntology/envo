    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A human construction which is used as a storage area for mining tailings.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Tailings#Tailings_dams_and_ponds"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03600022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115 xml:lang="en">A manufactured product which is formed as a liquid byproduct generated during the rectification and distillation of ethanol.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-02T21:33:40.901Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Vinasse is produced by the sugar or ethanol industry and can be produced at volumes as high as 20-fold of ethanol. It is typically sulfur-rich, low pH, dark-colored and odorous.</rdfs:comment>
        <rdfs:label xml:lang="en">vinasse</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A manufactured product which is formed as a liquid byproduct generated during the rectification and distillation of ethanol.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Vinasse"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.frontiersin.org/articles/10.3389/fenrg.2017.00007/full"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">Vinasse is produced by the sugar or ethanol industry and can be produced at volumes as high as 20-fold of ethanol. It is typically sulfur-rich, low pH, dark-colored and odorous.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Vinasse"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.frontiersin.org/articles/10.3389/fenrg.2017.00007/full"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03600030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105266"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00001998"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A soil layer which is parallel to the soil surface and which has roughly homogenous physical, chemical and biological properties relative to the soil layers above or beneath it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">soil horizon</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A soil layer which is parallel to the soil surface and which has roughly homogenous physical, chemical and biological properties relative to the soil layers above or beneath it.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Soil_horizon"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03600031 -->

