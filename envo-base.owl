                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental system determined by the presence of a plant rhizosphere.</obo:IAO_0000115>
