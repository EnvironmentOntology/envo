        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Rift</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake which fills a basin that has been dammed by wind-blown sand,  formed between sand dunes oriented by winds; or formed by wind action under previously arid paleoenvironments.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">aeolian lake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001105"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lake which fills a basin that has been dammed by wind-blown sand,  formed between sand dunes oriented by winds; or formed by wind action under previously arid paleoenvironments.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Lake#Aeolian_lakes</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001106">
