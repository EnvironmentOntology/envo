                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002016"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A solid layer which is composed primarily of sedimentary rock or soil.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
