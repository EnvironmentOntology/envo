    <!-- http://purl.obolibrary.org/obo/ENVO_01000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001103"/>
        <obo:IAO_0000115>Marine snow is a continuous shower of mostly organic detritus falling from the upper layers of the water column. Its origin lies in activities within the productive photic zone.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-20T08:51:49Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EcoLexicon:marine_snow</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605019"/>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>marine snow</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000158"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Marine snow is a continuous shower of mostly organic detritus falling from the upper layers of the water column. Its origin lies in activities within the productive photic zone.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ORCID:0000-0002-4366-3088</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Marine_snow</oboInOwl:hasDbXref>
    </owl:Axiom>
    


