    <!-- http://purl.obolibrary.org/obo/ENVO_01001063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom>
