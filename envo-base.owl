                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A high osmolarity environment is an environment in which entities are exposed to high concentrations of solutes.</obo:IAO_0000115>
        <rdfs:label>high osmolarity environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000315 -->

