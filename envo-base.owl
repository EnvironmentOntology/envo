    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000044"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000489"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Peatland typified by characteristic high mounds, each with a permanently frozen core, with wet depressions between the mounds.</obo:IAO_0000115>
        <rdfs:comment>These develop where the ground surface is frozen only for part of the year, and are common in the former USSR, Canada and parts of Scandinavia.</rdfs:comment>
        <rdfs:label>palsa mire</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000188"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
