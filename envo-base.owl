            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subtropical woodland biome which includes communities adapted to hot to warm, dry summers, mild to cold, rainy winters, and the influence of large, usually marine, bodies of water.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-07T15:01:04Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605013"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605022"/>
        <rdfs:comment>Preliminary definition. The semantics and definitions of &quot;mediterranean&quot;, &quot;subtropical&quot;, &quot;tropical&quot;, &quot;temperate&quot;, &quot;polar&quot;, and similar climate types may be transferred to an &quot;environmental condition&quot; class once the semantics of this class have been established.</rdfs:comment>
        <rdfs:label>mediterranean woodland biome</rdfs:label>
    </owl:Class>
    


