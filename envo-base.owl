            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A research facility in which systems of manufactured products control internal conditions and in which scientific or technological research, experiments, and measurement may be performed.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
        <oboInOwl:hasExactSynonym xml:lang="en">research laboratory</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605023"/>
        <rdfs:label xml:lang="en">laboratory facility</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research facility in which systems of manufactured products control internal conditions and in which scientific or technological research, experiments, and measurement may be performed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Laboratory</oboInOwl:hasDbXref>
    </owl:Axiom>
    


