        <obo:IAO_0000115>Bluegrass field soil is a soil which is found in a field of Kentucky Bluegrass (Poa pratensis).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00005789</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605015"/>
        <rdfs:label>bluegrass field soil</rdfs:label>
