    <!-- http://purl.obolibrary.org/obo/ENVO_01001653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000045"/>
        <obo:IAO_0000115>An estuary in which mixing by tidal forcing exceeds the force of riverine output, resulting in thorough homogenisation of the estuary&apos;s water column and the disappearance of a vertical salinity gradient and the freshwater-seawater boundary.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">well-mixed estuary</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001653"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An estuary in which mixing by tidal forcing exceeds the force of riverine output, resulting in thorough homogenisation of the estuary&apos;s water column and the disappearance of a vertical salinity gradient and the freshwater-seawater boundary.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Estuary#Classification_based_on_water_circulation"/>
    </owl:Axiom>
    


