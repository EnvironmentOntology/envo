                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000797"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An atmospheric escape process during which atoms that are parts of a planetary atmosphere escape into outer space through numerous collisions with lighter atoms in that atmosphere.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">hydrodynamic escape</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001158"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An atmospheric escape process during which atoms that are parts of a planetary atmosphere escape into outer space through numerous collisions with lighter atoms in that atmosphere.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Atmospheric_escape</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001160"/>
