            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000307"/>
        <obo:IAO_0000115>An environmental system determined by seawater.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ocean water environment</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>sea water environment</rdfs:label>
    </owl:Class>
    


