                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0000587"/>
                                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0001997"/>
                                                        </owl:intersectionOf>
