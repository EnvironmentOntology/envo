    <!-- http://purl.obolibrary.org/obo/ENVO_00000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000121"/>
        <obo:IAO_0000115>A man-made watercourse, or makeshift aqueduct, often an artificial channel which supplies water to a watermill or its mill pond, collecting water from upstream of the mill so that the natural level of the driving water is above the level of the stream at the mill. Alternatively to may deliver water for mineral washing and concentration, irrigation or to a dye works.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Leat</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lete</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00000544</oboInOwl:id>
        <rdfs:label>leat</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A man-made watercourse, or makeshift aqueduct, often an artificial channel which supplies water to a watermill or its mill pond, collecting water from upstream of the mill so that the natural level of the driving water is above the level of the stream at the mill. Alternatively to may deliver water for mineral washing and concentration, irrigation or to a dye works.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Leat</oboInOwl:hasDbXref>
    </owl:Axiom>
    


