        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000667"/>
        <obo:IAO_0000115 xml:lang="en">A geological fracture which is formed during winter months by a narrow or thin piece of ice.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-03T00:22:16.764Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">The ice itself can measure up to 3–4 meters in length at ground level can extend downwards into the ground up to several meters.</rdfs:comment>
        <rdfs:label xml:lang="en">ice wedge</rdfs:label>
