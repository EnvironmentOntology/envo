    <!-- http://purl.obolibrary.org/obo/ENVO_03600080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
        <obo:IAO_0000115 xml:lang="en">A human construction which is used for the purpose of industrial development.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-03T00:22:16.764Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Industrial parks are usually located on the edges of, or outside, the main residential area of a city and that can be thought of as a more &quot;heavyweight&quot; version of a business park or office park, which has offices and light industry, rather than heavy industry.</rdfs:comment>
        <rdfs:label xml:lang="en">industrial park</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A human construction which is used for the purpose of industrial development.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Industrial_park"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600080"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
