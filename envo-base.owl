        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002000"/>
        <obo:IAO_0000115>A gravelly slope is a slope which has a surface primarily composed of gravel.</obo:IAO_0000115>
        <rdfs:label>gravelly slope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000333">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
