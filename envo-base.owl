            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Anthropogenic litter which is present in a coastal environment.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
