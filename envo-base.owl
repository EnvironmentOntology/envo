    <!-- http://purl.obolibrary.org/obo/ENVO_03600072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000639"/>
        <obo:IAO_0000115 xml:lang="en">A planetary structural layer which consists of oceanic crust and the underlying upper mantle and has been uplifted and exposed above sea level.</obo:IAO_0000115>
