        <obo:IAO_0000115>An acidic environment is an environment in which material entities are exposed to a low pH.</obo:IAO_0000115>
        <rdfs:label>acidic environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000316 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000316">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000997"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001430"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000997"/>
        <obo:IAO_0000115>An alkaline environment is an environment in which entities are exposed to high pH, typically greater than a pH of 9.</obo:IAO_0000115>
        <rdfs:label>alkaline environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000317 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000317">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000254"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002507"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002006"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
        <obo:IAO_0000115>An environment whose dynamics are strongly influenced by water.</obo:IAO_0000115>
        <rdfs:label>aquatic environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000305"/>
        <obo:IAO_0000115>An extreme high temperature environment is a high temperature environment in which entities are exposed to temperatures above 80 degrees Celsius.</obo:IAO_0000115>
        <rdfs:comment>The lower threshold, 80 degrees Celsius, is derived from the definition of the obsolete class &quot;extreme high temperature habitat&quot; which this class replaces.</rdfs:comment>
        <rdfs:label>extreme high temperature environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000319">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010504"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00001995"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002000"/>
        <obo:IAO_0000115>A rocky slope is a slope which has a surface primarily composed of rock.</obo:IAO_0000115>
        <rdfs:label>rocky slope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000320">
        <owl:equivalentClass>
