        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tectonic earthquake which precedes the strongest tectonic earthquake in a series, linked to the same release of energy in the crust.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Foreshock"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001771 -->

