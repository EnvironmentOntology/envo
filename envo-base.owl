        <owl:annotatedTarget xml:lang="en">A volcano which has been formed as a result of the eruption of andesitic lava.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Andesite"/>
