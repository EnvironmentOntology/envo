        <oboInOwl:hasExactSynonym xml:lang="de">Plastikfragment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">fragmento de plástico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">frammento di plastica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plastic flake</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plastic granule</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset xml:lang="en">envoPlastics</oboInOwl:inSubset>
        <rdfs:comment xml:lang="en">To avoid ambiguity, we are being stricter with the &quot;has broken off of a larger piece of plastic&quot; aspect compared to the GESAMP report, which originally stated &quot;having appearance of being broken down from a larger piece of litter&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">plastic fragment</rdfs:label>
    </owl:Class>
