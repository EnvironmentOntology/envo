        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sea ice formation process during which seawater freezes onto young ice during the cold season, forming first year ice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Sea_ice#New_ice.2C_nilas_and_young_ice</oboInOwl:hasDbXref>
