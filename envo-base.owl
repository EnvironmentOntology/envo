        <obo:IAO_0000115>A mass wasting flow during which snow rapidly flows down a sloping surface.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>snowslide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>snowslip</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">avalanche</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass wasting flow during which snow rapidly flows down a sloping surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Mass_wasting</oboInOwl:hasDbXref>
    </owl:Axiom>
    


