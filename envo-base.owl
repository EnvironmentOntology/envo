            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An evergreen needleleaf forest which is subject to temperate climate patterns.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>coniferous forest</oboInOwl:hasBroadSynonym>
        <rdfs:comment>This class is one of the forest types as identified by the updated Global Forest Map (GFM 2000).</rdfs:comment>
        <rdfs:label>temperate evergreen needleleaf forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
