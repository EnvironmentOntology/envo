    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A spring through which fresh water flows.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">freshwater spring</rdfs:label>
    </owl:Class>
    


