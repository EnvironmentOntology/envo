        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000067"/>
        <obo:IAO_0000115>A cave in present-day or emerged sea cliffs, formed by wave attack or solution.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Sea_cave</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
