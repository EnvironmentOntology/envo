        <oboInOwl:hasRelatedSynonym>precipitation quantity</oboInOwl:hasRelatedSynonym>
        <rdfs:comment xml:lang="de">While the precipitated material may be water in any of its forms, the volume that this class refers to is that of liquid water.</rdfs:comment>
        <rdfs:label xml:lang="en">volume of hydrological precipitation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001363"/>
