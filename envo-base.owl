    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001731 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001730"/>
        <obo:IAO_0000115>A jet-effect which passes through a gap, constriction, or channel between mountains in a mountain range or between ranges themselves.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-02T02:40:43Z</dc:date>
        <oboInOwl:hasNarrowSynonym>düsenwind</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>kossava</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>tehuantepecer</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">mountain-gap wind</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A jet-effect which passes through a gap, constriction, or channel between mountains in a mountain range or between ranges themselves.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Jet-effect_wind"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001732">
