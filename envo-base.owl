        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-27T09:10:14Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="it">termoplasticità</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="zh">熱塑性</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset xml:lang="en">envoPlastics</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">thermoplasticity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A disposition inhering in a bearer by virtue of that bearer&apos;s ability to, repeatedly, become plastic on heating and harden again on cooling.</owl:annotatedTarget>
