                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A positional quality which inheres in a bearer by virtue of the bearer in being in physical contact with, or close to, a glacial margin.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-09T18:22:06Z</dc:date>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/phenCryo/Proglacial"/>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/ESIPFed/sweet/issues/219"/>
        <rdfs:comment>The meaning of &quot;close to&quot; is hard to represent accurately. Community agreement on this is not visible.</rdfs:comment>
        <rdfs:label xml:lang="en">proglacial</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001879"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A positional quality which inheres in a bearer by virtue of the bearer in being in physical contact with, or close to, a glacial margin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001879"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget rdf:resource="http://sweetontology.net/phenCryo/Proglacial"/>
        <rdfs:comment>In SWEET this is modelled as a process, however the GCW definitions to not support this understanding.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001624"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A positional quality which inheres in a bearer by virtue of the bearer in being in physical contact with or below a glacial bed.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-09T18:28:52Z</dc:date>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/phenCryo/Subglacial"/>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/ESIPFed/sweet/issues/219"/>
        <rdfs:comment>The lower bound of &quot;below&quot; is ambiguous.</rdfs:comment>
        <rdfs:label xml:lang="en">subglacial</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001880"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
