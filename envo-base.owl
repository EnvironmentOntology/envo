            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sea ice formation process during which seawater freezes into second year ice during the cold season, forming multiyear ice.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
