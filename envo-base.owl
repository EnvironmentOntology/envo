            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A section of the Earths&apos;s crust that is demarcated by faults or flexures. In the movement of the crust, a massif tends to retain its internal structure while being displaced as a whole.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:massif</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:946</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21435</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Massif</oboInOwl:hasDbXref>
        <rdfs:label>massif</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000381"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A section of the Earths&apos;s crust that is demarcated by faults or flexures. In the movement of the crust, a massif tends to retain its internal structure while being displaced as a whole.</owl:annotatedTarget>
