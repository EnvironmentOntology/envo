        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/thermoplastic"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115 xml:lang="en">An environmental material which is capable of, repeatedly, becoming plastic when heated and hardening again when cooled.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
