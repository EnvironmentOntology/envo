        <rdfs:label xml:lang="en">atmospheric zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001645"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000797"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001575"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A gaseous part of an atmosphere in which gases have reduced atmospheric pressure.</obo:IAO_0000115>
        <rdfs:comment>Air is not specified directly (although the definition subsumes air masses) to allow for other forms of low pressure areas in planetary atmospheres.</rdfs:comment>
        <rdfs:label xml:lang="en">area of low atmospheric pressure</rdfs:label>
    </owl:Class>
    


