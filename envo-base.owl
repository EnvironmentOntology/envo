            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process whereby a volume of liquid moves due to a disequilibrium of physical forces.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>This class can refer to the flow of any material in a liquid phase.</rdfs:comment>
        <rdfs:label xml:lang="en">mass liquid flow</rdfs:label>
    </owl:Class>
