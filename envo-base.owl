                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001420"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A long and narrow sheet of ice projecting out from the coastline. An ice tongue forms when a valley glacier moves very rapidly out into the ocean or a lake.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TGN:21143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ice_tongue</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>glacier tongue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>glacial tongue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>ice tongue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000392"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
