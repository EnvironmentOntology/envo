        <oboInOwl:hasRelatedSynonym>truck farm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>truck garden</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cultivated environment</rdfs:label>
    </owl:Class>
