        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A ridge which is jagged, narrow and separates glacier valleys or cirques.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-0337-8610"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-2282-7215"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-2908-3327"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-3410-4655"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-0632-7576"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-14T18:57:18.275Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/realmLandGlacial/Arete"/>
        <oboInOwl:hasDbXref>FTT:154</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ridge</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoCryo</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment xml:lang="en">The ridge frequently resembles the blade of a serrated knife. A French term referring to the bones in a fish backbone. Aretes are typically formed when two glaciers erode parallel U-shaped valleys. Aretes can also form when two glacial cirques erode towards one another, although frequently this results in a saddle-shaped pass, called a col.</rdfs:comment>
        <rdfs:label>arete</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000429"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A ridge which is jagged, narrow and separates glacier valleys or cirques.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000429"/>
