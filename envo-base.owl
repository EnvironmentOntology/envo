    <!-- http://purl.obolibrary.org/obo/ENVO_01000312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000313"/>
        <obo:IAO_0000115>A culturing environment is an environment which is maintained by humans for the purposes of preparing cell, organ, tissue and plant tissue cultures.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <rdfs:label>culturing environment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A culturing environment is an environment which is maintained by humans for the purposes of preparing cell, organ, tissue and plant tissue cultures.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Cell_culture</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000313">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
