        <obo:IAO_0000115 xml:lang="en">A part of a cloud.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">This definition is practical but may need refinement.</obo:IAO_0000116>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <rdfs:label xml:lang="en">cloud part</rdfs:label>
    </owl:Class>
    


