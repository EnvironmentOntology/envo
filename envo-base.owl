        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000327"/>
        <obo:IAO_0000115>A speleothem hanging downwards from a roof or wall, of cylindrical or conical form, usually with a central hollow tube.</obo:IAO_0000115>
