    <!-- http://purl.obolibrary.org/obo/ENVO_02000130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000127"/>
        <obo:IAO_0000115>molten bottom ash from slag tap and cyclone type furnaces that turns into pellets that have a smooth glassy appearance after it is cooled with water.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">boiler slag</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000130"/>
