        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment xml:lang="en">The original definition has been edited to conform to ENVO&apos;s textual pattern. Subjective/observer-based differentia (e.g. visibility) have been moved to comments.</rdfs:comment>
        <rdfs:label xml:lang="en">winter blizzard</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000136"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A blizzard which occurs in winter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://www.physicalgeography.net/glossary.html"/>
