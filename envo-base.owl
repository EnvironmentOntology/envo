        <obo:IAO_0000115>A sea ice formation process during which seawater freezes onto young ice during the cold season, forming first year ice.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>First year ice that survives melting during spring and summer can transition to second year ice.</rdfs:comment>
        <rdfs:label xml:lang="en">first year ice formation process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
