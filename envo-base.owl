            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A booth with an open window on one side.</obo:IAO_0000115>
        <obo:IAO_0000116>The relation between booths and buildings needs to be clarified. Booth should be its own class.</obo:IAO_0000116>
        <rdfs:comment>This definition of kiosk is characteristic of the Western hemisphere and used in English-speaking countries.</rdfs:comment>
        <rdfs:label xml:lang="en">kiosk</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000973"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A booth with an open window on one side.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Kiosk</oboInOwl:hasDbXref>
