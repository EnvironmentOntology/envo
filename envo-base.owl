        </rdfs:subClassOf>
        <obo:IAO_0000115>A layer of liquid that is part of an estuary.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoMarine</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
