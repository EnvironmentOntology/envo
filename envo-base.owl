    <!-- http://purl.obolibrary.org/obo/ENVO_00000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000044"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000134"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001370"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Peatlands with a shallow peat layer, only about 500 mm thick, dominated by sedges and grasses. They form in permafrost areas, covering around 110,000 to 160,000 km2 in Alaska, Canada, and the former USSR.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>tundra mire</rdfs:label>
    </owl:Class>
    <owl:Axiom>
