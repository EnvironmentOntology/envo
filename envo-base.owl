            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A channel which is constructed by removing materials from land or submerged beds.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SWEETRealm:Borehole</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Borehole</oboInOwl:hasDbXref>
        <rdfs:label>borehole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00002227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002227">
        <obo:IAO_0000115>A habitat that is in or on a body of water containing medium to high concentrations of dissolved salts and other total dissolved solids (&gt;=0.5 grams dissolved salts per litre).</obo:IAO_0000115>
        <obo:IAO_0100001>ENVO:01000307</obo:IAO_0100001>
        <oboInOwl:hasExactSynonym>salt water habitat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00002227</oboInOwl:id>
        <rdfs:label>obsolete saline water habitat</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002227"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A habitat that is in or on a body of water containing medium to high concentrations of dissolved salts and other total dissolved solids (&gt;=0.5 grams dissolved salts per litre).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NM:nm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00002228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002228">
