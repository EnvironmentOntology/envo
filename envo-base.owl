    <!-- http://purl.obolibrary.org/obo/ENVO_01000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000076">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
