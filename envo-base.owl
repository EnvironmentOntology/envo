                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A piece of rock which is between two and 64 millimetres in length along its largest dimension.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Arguably, this could be placed in the &quot;particle&quot; hierarchy, but is usually considered too large in everyday semantics.</rdfs:comment>
        <rdfs:label>piece of gravel</rdfs:label>
    </owl:Class>
