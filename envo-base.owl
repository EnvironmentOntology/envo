            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A class created to group GFM 2000 terms by the dominant vegetation type. Definitions pending.</rdfs:comment>
        <rdfs:label>swamp forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001243"/>
