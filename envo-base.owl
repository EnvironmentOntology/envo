        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A material congelation process during which a liquid turns into a solid when its temperature is lowered below its melting point.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Freezing</oboInOwl:hasDbXref>
    </owl:Axiom>
    


