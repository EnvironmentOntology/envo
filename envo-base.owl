                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A stellar radiation process during which electromagnetic waves or their quanta are emitted from a star at wavelengths between 10 nm and 400 nm.</obo:IAO_0000115>
        <obo:IAO_0000116>To be expanded to account for subtypes.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>NCIT:C17231</oboInOwl:hasDbXref>
