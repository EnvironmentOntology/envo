        <dc:creator rdf:resource="https://orcid.org/0000-0002-8461-9745"/>
        <rdfs:label xml:lang="en">soil layer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105267">
