    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001032">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
