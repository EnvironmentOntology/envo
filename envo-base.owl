                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000888"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A land fire which consumes low-growing plants such as scrub and brush.</obo:IAO_0000115>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">brush fire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001290">
