            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lava flow is a moving outpouring of lava, which is created during a non-explosive effusive eruption.</obo:IAO_0000115>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label>lava flow</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000438"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lava flow is a moving outpouring of lava, which is created during a non-explosive effusive eruption.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Lava</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000439">
