            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A water flow process during which water is transported through an aquifer.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-22T14:22:43Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">groundwater flow</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A water flow process during which water is transported through an aquifer.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Groundwater_discharge</oboInOwl:hasDbXref>
