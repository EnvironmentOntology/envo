        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000012"/>
        <obo:IAO_0000115 xml:lang="en">A feature which arises from a rapid multiplication of cyanobacteria, causing marked visible discoloration of the water.</obo:IAO_0000115>
