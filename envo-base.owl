        <owl:annotatedTarget>ridge</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ADL:FTT</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000429"/>
