        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://sweetontology.net/realmCryo/IceField</owl:annotatedTarget>
        <obo:IAO_0000116>Note that SWEET&apos;s IceField only refers to sea ice fields.</obo:IAO_0000116>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>The floes in a sea ice field must be greater than 10 km across, at least at one location in the field.</owl:annotatedTarget>
