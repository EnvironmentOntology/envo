        <obo:IAO_0000115>A depression which comprises a low tract of land, especially when moist or marshy.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:swale</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>trough</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The term can refer to a natural landscape feature or a human-created one. When created by humans, this open drain system is designed to manage water runoff.</rdfs:comment>
        <rdfs:label>swale</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000543"/>
