    <!-- http://purl.obolibrary.org/obo/ENVO_00000418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000100"/>
        <obo:IAO_0000115>A submergent coastal landform that forms where sea levels rise relative to the land either as a result of eustatic sea level change; where the global sea levels rise or isostatic sea level change; where the land sinks. When this happens valleys which were previously at sea level become submerged.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ria</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>drowned river valley</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>drowned valley</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>valley</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ENVO:00000418</oboInOwl:id>
        <rdfs:label>ria</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A submergent coastal landform that forms where sea levels rise relative to the land either as a result of eustatic sea level change; where the global sea levels rise or isostatic sea level change; where the land sinks. When this happens valleys which were previously at sea level become submerged.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ria</oboInOwl:hasDbXref>
    </owl:Axiom>
