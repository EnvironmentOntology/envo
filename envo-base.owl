    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000873"/>
        <rdfs:subClassOf>
