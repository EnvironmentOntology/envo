                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A construction which contains the equipment needed to perform mariculture in open cages - permitting the exchange of material with the surrounding marine water.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-15T22:31:31Z</dc:date>
        <rdfs:label xml:lang="en">open cage mariculture facility</rdfs:label>
    </owl:Class>
