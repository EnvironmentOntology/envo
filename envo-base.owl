                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002354"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
