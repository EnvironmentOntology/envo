        <obo:IAO_0000115>An electromagnetic radiation process during which electromagnetic waves or their quanta are emitted from a star.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCIT:C44445</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>solar radiation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">stellar radiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electromagnetic radiation process during which electromagnetic waves or their quanta are emitted from a star.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Electromagnetic_radiation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Solar_irradiance</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>solar radiation</owl:annotatedTarget>
