        <rdfs:label xml:lang="en">frozen soil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001526"/>
