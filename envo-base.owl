        <oboInOwl:hasDbXref>SWEETRealm:AlluvialFan</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21421</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Alluvial_fan</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fan (alluvial)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fan</oboInOwl:hasRelatedSynonym>
        <rdfs:label>alluvial fan</rdfs:label>
    </owl:Class>
