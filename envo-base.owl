                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010504"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000406"/>
                                    </owl:Restriction>
