                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000380"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000392"/>
                        </owl:unionOf>
                    </owl:Class>
