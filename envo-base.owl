        <obo:IAO_0000115>A planned environmental usage process during which an environment supports the settlement and dwelling of a community of humans.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:hasBroadSynonym>residential</oboInOwl:hasBroadSynonym>
        <rdfs:comment>This class does not include environments which are primarily used for commerce or industry.</rdfs:comment>
        <rdfs:label xml:lang="en">usage of an environment for residential activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001446"/>
