        <oboInOwl:hasRelatedSynonym>delta moraine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>moraine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>terminal moraine</rdfs:label>
