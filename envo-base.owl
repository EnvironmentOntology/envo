        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Kerogen from which heavy hydrocarbons (such as oils) are derived following chemical break down.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Kerogen</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001234">
