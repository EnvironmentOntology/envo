                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000267"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000635"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000817"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000819"/>
