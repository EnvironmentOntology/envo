    <!-- http://purl.obolibrary.org/obo/ENVO_00002128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000126"/>
        <obo:IAO_0000115 xml:lang="en">A sulfur spring through which water at a temperature optimal for the growth of mesophillic microorganism (approximately 20 to 45 degrees Celsius) flows.</obo:IAO_0000115>
        <rdfs:label>mesophilic sulfur spring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
