            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Frozen soil which is cemented by water ice but has viscous properties due to its high, unfrozen water content and therefore will compress and deform under load.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-14T21:23:25Z</oboInOwl:creation_date>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-14T21:28:28Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605015"/>
        <rdfs:label xml:lang="en">plastic-frozen soil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
