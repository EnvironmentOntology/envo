        <rdfs:comment xml:lang="en">Monuments can commemorate people, animals, populations, events, or any other entity.</rdfs:comment>
        <rdfs:label xml:lang="en">constructed monument</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/EnvironmentOntology/envo/issues/1213"/>
    </owl:Class>
