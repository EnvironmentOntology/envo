    <!-- http://purl.obolibrary.org/obo/ENVO_00000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000243"/>
        <obo:IAO_0000115>A palustrine wetland with deep, acidic, sandy, peat soils. Groundwater saturates the soil except during brief seasonal dry spells and during prolonged droughts. Pocosin soils are nutrient deficient (oligotrophic), especially in phosphorus.</obo:IAO_0000115>
        <rdfs:label>pocasin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000239"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A palustrine wetland with deep, acidic, sandy, peat soils. Groundwater saturates the soil except during brief seasonal dry spells and during prolonged droughts. Pocosin soils are nutrient deficient (oligotrophic), especially in phosphorus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Pocosin</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wetland ecosystem in which soil is saturated with saline water.</obo:IAO_0000115>
        <obo:IAO_0000116>It would be more correct to say that this has_quality salty or has_part ((soil and water) and has_increased_levels_of salt.</obo:IAO_0000116>
        <rdfs:label>saline wetland</rdfs:label>
    </owl:Class>
    


