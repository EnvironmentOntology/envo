    <!-- http://purl.obolibrary.org/obo/ENVO_00000277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake that has either permanently or temporally lost its water.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>lake</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FTT:650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:H.LBED</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:DryLake</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Dry_lake</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>lake bed</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Classes like this pose a logical problem. This probably shouldn&apos;t be a lake (water body) but a depression. Lakes which have temporarily lost water should be distinguished from permanently dry lakes.</rdfs:comment>
        <rdfs:label>dry lake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lake that has either permanently or temporally lost its water.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MA:ma</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000277"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
