        <owl:annotatedTarget>A harbor which is formed by a natural landform where a part of a body of water is protected and deep enough to furnish anchorage.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Harbor</oboInOwl:hasDbXref>
    </owl:Axiom>
    


