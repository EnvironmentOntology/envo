        <obo:IAO_0000115 xml:lang="en">A bioreactor which has a membrane as a part</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-02T21:33:40.901Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">It is widely used for municipal and industrial wastewater treatment. The membrane is usually used to perform microfiltration, ultrafiltration or osmosis, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">membrane bioreactor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A bioreactor which has a membrane as a part</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Membrane_bioreactor"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">It is widely used for municipal and industrial wastewater treatment. The membrane is usually used to perform microfiltration, ultrafiltration or osmosis, etc.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Membrane_bioreactor"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03600011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03600011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000256"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A soil horizon which is primarily composed of mineral material.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">ADDED &apos;composed primarily of&apos; RO:0002473 mineral material &apos;ENVO:01000256&apos;</obo:IAO_0000116>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6670-9157"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-02T21:33:40.901Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Usually less than 20% organic carbon. The term mineral horizon refers to surface soil/topsoil and subsoil layer of the soil. When user does not/could not refer to the topsoil or subsoil specifically, the broader term, mineral horizon can be used.</rdfs:comment>
        <rdfs:label xml:lang="en">mineral horizon</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03600011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A soil horizon which is primarily composed of mineral material.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Soil_horizon"/>
        <oboInOwl:hasDbXref rdf:resource="https://pikeconservation.org/soil-profile/#:~:text=The%20uppermost%20horizon%20is%20called,nutrients%20that%20enrich%20the%20soils"/>
    </owl:Axiom>
    


