        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Water with a nutrient level intermediate between eutrophic and oligotrophic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MA:ma</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00002226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000117"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002151"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000501"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000635"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000751"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
