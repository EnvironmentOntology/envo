    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000236"/>
        <obo:IAO_0000115>A dambo associated with a river.</obo:IAO_0000115>
