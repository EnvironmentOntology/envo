                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00001995"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001069"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An astronomical body which is composed of rocky or metallic materials and is considerably smaller than asteroids.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">meteoroid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An astronomical body which is composed of rocky or metallic materials and is considerably smaller than asteroids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Meteoroid</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
