        <obo:IAO_0000115>A material congelation process during which a liquid turns into a solid when its temperature is lowered below its melting point.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-31T21:13:16Z</oboInOwl:creation_date>
