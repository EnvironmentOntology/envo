                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000247"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stormwater which accumulates in a rural ecosystem.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>rural storm water</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605019"/>
        <rdfs:comment>&quot;Stormwater can soak into the soil (infiltrate), be held on the surface and evaporate, or runoff and end up in nearby streams, rivers, or other water bodies (surface water).&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">rural stormwater</rdfs:label>
    </owl:Class>
