        <oboInOwl:hasDbXref>https://www.wikidata.org/wiki/Q4989906</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom>
                    <owl:Class>
