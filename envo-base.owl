        <obo:IAO_0000115 xml:lang="en">A freshwater biome which is determined by a freshwater river.</obo:IAO_0000115>
        <oboInOwl:creation_date>2013-09-19T11:11:01Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605017"/>
