            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tectonic earthquake which precedes the strongest tectonic earthquake in a series, linked to the same release of energy in the crust.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-07T13:43:56Z</dc:date>
        <rdfs:label xml:lang="en">foreshock</rdfs:label>
    </owl:Class>
