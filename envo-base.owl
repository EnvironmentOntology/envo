        <obo:IAO_0000115>An aquatic biome which is determined by a marine water body.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SPIRE:Marine</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>marine realm</oboInOwl:hasRelatedSynonym>
