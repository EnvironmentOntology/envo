                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002180"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A geomorphological feature which is formed where two or more tectonic plates move towards, away from, or along one another, resulting in deformation of the lithosphere.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">tectonic plate boundary</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001098"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
