            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Particulate environmental material in which small portions of solid material are surrounded by water.</obo:IAO_0000115>
        <obo:IAO_0000116>This class should be populated by inference, relying on &apos;composed primarily of&apos;, many &apos;pieces of solid material&apos; and &apos;surrounded by&apos; some &apos;water&apos;.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">waterborne particulate matter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000352"/>
