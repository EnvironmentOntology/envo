    <!-- http://purl.obolibrary.org/obo/ENVO_00009003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00009003">
        <obo:IAO_0000115>A habitat that is in or on a living animal. Here &quot;animal&quot; denotes an individual of a species that is a sub-taxon of NCBITaxon:9606.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00009003</oboInOwl:id>
        <rdfs:comment>Used for armpits and other nasty places.</rdfs:comment>
        <rdfs:label>obsolete human-associated habitat</rdfs:label>
