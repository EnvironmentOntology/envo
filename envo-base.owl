        </rdfs:subClassOf>
        <obo:IAO_0000115>A process during which gases that constitute a planetary atmosphere escape that planet&apos;s gravitational field and move away into outer space.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">atmospheric escape</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
