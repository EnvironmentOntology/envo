        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A piece of rock which has a grain size between 64 and 256 mm.</owl:annotatedTarget>
