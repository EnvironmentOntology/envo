            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thermolysis process in which organic material is decomposed in the absence of oxygen.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pyrolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000842 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000842">
