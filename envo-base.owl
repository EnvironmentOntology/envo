        <obo:IAO_0000115 xml:lang="en">A material transport process during which liquid water is circulated in the vicinity of a heat source in order to absorb thermal energy and transport it away form that source.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-3410-4655"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <rdfs:label xml:lang="en">water cooling</rdfs:label>
    </owl:Class>
    


