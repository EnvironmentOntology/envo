                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000918"/>
        <obo:IAO_0000115>The volume of water which has fallen during a precipitation process.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="de">Niederschlagsmenge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>precipitation amount</oboInOwl:hasExactSynonym>
