SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000172> <http://purl.obolibrary.org/obo/ENVO_01000168>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000172> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01000168>))

