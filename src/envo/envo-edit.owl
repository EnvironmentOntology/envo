SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001450> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <http://purl.obolibrary.org/obo/ENVO_00002267>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001451> (usage of an environment for business)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/1084") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001451> "A planned environmental usage process during which an environment supports facilities associated with commerce or the earning of a livelihood through means other than manufacturing or the provision of a public service.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01001451> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001451> "This class includes activities carried out in commercial offices, meeting centres, art studios, recording studios, film sets, warehouses, and distribution centres.")
