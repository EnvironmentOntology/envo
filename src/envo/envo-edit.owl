AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000899> "A lightning process during which electrostatic discharge occurs between at least two clouds.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000899> "CC lightning")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000899> "cloud-cloud lightning")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000899> "environmental_hazards")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000899> "intercloud lightning"@en)
