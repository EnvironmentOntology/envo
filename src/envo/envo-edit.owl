AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01003017> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003017> "irradiation by photosynthetically active radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003017> <http://purl.obolibrary.org/obo/ENVO_01003016>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003017> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01001864>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003018> (electromagnetic wave energy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Electromagnetic_radiation>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.studysmarter.us/explanations/physics/turning-points-in-physics/electromagnetic-waves/>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003018> "Wave energy which inheres in perpendicular electric and magnetic fields and which is realised when they oscillate and propagate."@en)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://purl.obolibrary.org/obo/ENVO_01003018> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01003018> "electromagnetic radiant energy"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003018> "electromagnetic wave energy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003018> <http://purl.obolibrary.org/obo/ENVO_01003019>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003018> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/ENVO_01001026>))

