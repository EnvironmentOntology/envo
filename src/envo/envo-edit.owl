AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_03600035> "chiller room"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_03600035> "cool room"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_03600035> "refrigerating chamber"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03600035> "Cold rooms are generally used as walk-in storage facilities or to perform tasks requiring cooler ambient temperatures."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03600035> "cold room"@en)
