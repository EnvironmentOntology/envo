AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105278> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105278> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105278> "2021-12-26T22:13:01Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105278> "Some authorities consider silty clay loam to be a soil composed of 0-20% of sand, 40-73 of silt and 27-40% of clay."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105278> "silty clay loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105278> <http://purl.obolibrary.org/obo/ENVO_06105277>)
