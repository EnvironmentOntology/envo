AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000349> "Requested in Issue 115 as part of the annotation of metagenomic submissions present in the European Nucleotide Archive.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000349> "root matter")
