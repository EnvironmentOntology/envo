AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000900> "environmental_hazards")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000900> "intracloud lightning"@en)
