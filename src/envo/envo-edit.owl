# Class: <http://purl.obolibrary.org/obo/ENVO_01000612> (taxicab)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Taxicab") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000612> "A taxicab is a car which may be hired, along with its operator, to transport passengers between locations of their choosing.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000612> "cab")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000612> "taxi")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000612> "Depth can be added with specifications of BFO:role for both the car and the human operator.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000612> "taxicab"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000612> <http://purl.obolibrary.org/obo/ENVO_01000605>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000613> (watercraft)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Watercraft") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000613> "A watercraft is a vehicle which is able to travel on or through water.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000613> "Ships, boats, hovercraft and submarines are all considered watercraft. The term would normally imply some propulsive capability (whether by sail, oar or engine) and hence is distinct from a simple device that merely floats, such as a log raft. - Wikipedia")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000613> "watercraft"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000613> <http://purl.obolibrary.org/obo/ENVO_01000604>)

