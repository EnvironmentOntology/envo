AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01001012> "envoAtmo")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001012> "lithometeor"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001012> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01001008> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00001995>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001012> <http://purl.obolibrary.org/obo/ENVO_01001008>)
