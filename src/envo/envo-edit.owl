AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000958> "Earth-like planet")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000958> "envoAstro")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000958> "terrestrial planet"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000958> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000800> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_00001995> <http://purl.obolibrary.org/obo/ENVO_01001069>))))
