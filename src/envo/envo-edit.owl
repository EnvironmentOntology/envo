# Class: <http://purl.obolibrary.org/obo/ENVO_03600078> (oil refinery)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Oil_refinery>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03600078> "An industrial building in which crude oil is transformed and refined into useful products."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_03600078> <https://orcid.org/0000-0002-6670-9157>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_03600078> "2021-07-03T00:22:16.764Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Oil_refinery>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03600078> "The useful products include petroleum naphtha, gasoline, diesel fuel, asphalt base, heating oil, kerosene, liquefied petroleum gas, jet fuel and fuel oils. Oil refineries are typically large, sprawling industrial complexes with extensive piping running throughout, carrying streams of fluids between large chemical processing units, such as distillation columns."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03600078> "oil refinery"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03600078> <http://purl.obolibrary.org/obo/ENVO_00003861>)

