AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://glossary.ametsoc.org/wiki/Temperate_climate>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001705> "An environment which is located in a part of an astronomical body subject to temperate climatic conditions."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001705> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001705> "2019-08-20T16:41:52Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001705> "temperate environment"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001705> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000254> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/ENVO_01000206>)))
