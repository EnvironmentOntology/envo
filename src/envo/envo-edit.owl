AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001444> "usage of an environment for transportation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001444> <http://purl.obolibrary.org/obo/ENVO_01001436>)
