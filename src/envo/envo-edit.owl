AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01001443> "recreation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001443> "usage of an environment for recreation"@en)
