# Class: <http://purl.obolibrary.org/obo/ENVO_01000563> (central-draught lamp)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Kerosene_lantern") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000563> "A central-draught lamp is a paraffin lamp which burns a parrafin saturated, tubular wick contained between two structural tubes and supplied with oxygen by a central draught of air through the innermost of these tube.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000563> "Argand lamp")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000563> "central draught lamp")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000563> "tubular round wick lamp")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000563> "central-draught lamp"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000563> <http://purl.obolibrary.org/obo/ENVO_01000561>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000564> (mantle lamp)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Kerosene_lantern") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000564> "A mantle lamp is a central-draught lamp which includes a pear-shaped, fabric mesh containing thorium or other rare-earth salts placed over the burner. On first use the fabric burns away and the rare-earth salts are converted to oxides, leaving a very fragile structure which incandesces (glows brightly) upon exposure to the heat of the burner flame.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000564> "mantle lamp"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000564> <http://purl.obolibrary.org/obo/ENVO_01000563>)

