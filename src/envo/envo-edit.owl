AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/4321") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/6822") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001445> "A planned environmental usage process during which an environment supports 1) enterprises concerned with the provision to the public of essentials, such as electricity or water or 2) the basic network or foundation of capital facilities or community investments which are necessary to support economic and community activities.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01001445> <https://orcid.org/0000-0002-4366-3088>)
