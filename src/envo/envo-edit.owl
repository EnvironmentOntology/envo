AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105026> "granule of plastic foam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105026> <http://purl.obolibrary.org/obo/ENVO_06105006>)

