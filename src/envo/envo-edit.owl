AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ENVO_01000286> "ENVO")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_01000286> "ENVO:01000286")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000286> "dimictic lake")
