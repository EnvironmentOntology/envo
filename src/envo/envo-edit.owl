SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/CHEBI_36342>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_00010483>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001024> (particle radiation)

