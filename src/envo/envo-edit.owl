AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000591> "bedstead")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000591> "bed frame"@en)
