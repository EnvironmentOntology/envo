AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03600015> "polluted river"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03600015> <http://purl.obolibrary.org/obo/ENVO_00000022>)
