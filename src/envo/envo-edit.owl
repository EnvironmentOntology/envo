# Class: <http://purl.obolibrary.org/obo/ENVO_01001459> (high-elevation mountain)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.doi.org/10.1079/9780851994468.0004") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.wikialps.eu/doku.php?id=wiki:mountain_and_mountain_area") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://wayback.archive-it.org/all/20080511044709/http://www.unep-wcmc.org/mountains/mountain_watch/pdfs/WholeReport.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cabi.org/cabebooks/ebook/20000614040") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001459> "A mountain which has a maximum elevation greater than 2500 metres above sea level.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_01001459> "https://orcid.org/0000-0002-7556-2097")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01001459> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001459> "On Earth, mountains in this category cross the atmospheric oxycline above which oxygen concentrations fall below the physiological tolerance threshold of most humans. Note that the threshold elevations are inconsistent between the various reports which list this classification: while some have overlapping thresholds, others are non-overlapping. The latter model is used in ENVO for coherence and to adhere to the Kapos et al. 2000 reference.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001459> "high-elevation mountain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001459> <http://purl.obolibrary.org/obo/ENVO_00000081>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001460> (mid-elevation mountain)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.doi.org/10.1079/9780851994468.0004") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.wikialps.eu/doku.php?id=wiki:mountain_and_mountain_area") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://wayback.archive-it.org/all/20080511044709/http://www.unep-wcmc.org/mountains/mountain_watch/pdfs/WholeReport.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cabi.org/cabebooks/ebook/20000614040") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001460> "A mountain which has a maximum elevation between 300 and 2499 metres above sea level and slopes greater than or equal to two degrees of inclination.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_01001460> "https://orcid.org/0000-0002-7556-2097")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01001460> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001460> "On Earth, mountains in this category are below the atmospheric oxycline above which oxygen concentrations fall below the physiological tolerance threshold of most humans. Note that the threshold elevations are inconsistent between the various reports which list this classification: while some have overlapping thresholds, others are non-overlapping. The latter model is used in ENVO for coherence and to adhere to the Kapos et al. 2000 reference.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001460> "mid-elevation mountain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001460> <http://purl.obolibrary.org/obo/ENVO_00000081>)

