SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001711> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01001712>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001712> (free atmosphere)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://glossary.ametsoc.org/wiki/Free_atmosphere>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001712> "An atmospheric layer which 1) is located above the planetary boundary layer, 2) in which the effect of friction between moving air masses and the planetary surface is negligible, and 3) in which the air is usually treated (dynamically) as an ideal fluid.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001712> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001712> "2019-08-21T16:33:07Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://glossary.ametsoc.org/wiki/Free_atmosphere>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001712> "\"The base of the free atmosphere is usually taken as the geostrophic wind level.\"")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001712> "free atmosphere"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001712> <http://purl.obolibrary.org/obo/ENVO_01000543>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001712> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> ObjectComplementOf(<http://purl.obolibrary.org/obo/ENVO_01000323>)))

