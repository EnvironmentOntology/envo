AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000186> "polar desert biome")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000186> <http://purl.obolibrary.org/obo/ENVO_01000179>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000186> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/ENVO_01000238>))

