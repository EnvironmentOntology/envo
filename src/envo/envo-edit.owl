AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000592> "A bed base is a piece of furniture which supports a mattress.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000592> "bed foundation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000592> "bed base"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000592> <http://purl.obolibrary.org/obo/ENVO_01000587>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000593> (framed bed)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Bed") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000593> "A framed bed is a piece of furniture which is composed of a mattress supported by a bed base and held in place by a bed frame.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000593> "framed bed"@en)
