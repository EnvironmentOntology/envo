AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_01000169> "ENVO:01000169")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000169> "indeterminate root nodule active meristem")
