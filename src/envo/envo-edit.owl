AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01001219> "envoAstro")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001219> "ionizing stellar radiation"@en)
