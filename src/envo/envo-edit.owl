SubClassOf(Annotation(rdfs:comment "QCR: 'has participant' max 1 cloud") <http://purl.obolibrary.org/obo/ENVO_01000900> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_01000760>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000901> (lightning strike)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000901> "A lightning process during which electrostatic discharge occurs between a cloud and an object on a planetary surface, or a planetary surface itself.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000901> "CG lightning")
