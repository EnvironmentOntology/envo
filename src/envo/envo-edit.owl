AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Estuary>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_00000229> "An estuary which varies dramatically in its volume as a result of intermittent freshwater input, and is capable of changing from a wholly marine embayment to any other type of estuary.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000229> "intermittent estuary")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000229> <http://purl.obolibrary.org/obo/ENVO_00000045>)

