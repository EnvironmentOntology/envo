SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000699> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> ObjectUnionOf(<http://purl.obolibrary.org/obo/ENVO_00000247> <http://purl.obolibrary.org/obo/ENVO_00000398>)))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000700> (sturzstrom)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Sturtzstrom") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000700> "A sturzstrom is a landslide consisting which has a great amount of kinetic energy resulting in greater horizontal movement when compared to its initial vertical drop — as much as 20 or 30 times the vertical distance. By contrast a normal landslide will typically travel a horizontal distance that is less than twice the distance that the material has fallen.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000700> "sturzstrom"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000700> <http://purl.obolibrary.org/obo/ENVO_01000692>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000701> (volcanic ash)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Volcanic_ash") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000701> "Volcanic ash is an environmental material which consists of fragments of pulverized rock, minerals, and volcanic glass, created during volcanic eruptions and measuring less than 2 millimetres in diameter. Volcanic ash is formed during explosive volcanic eruptions, phreatomagmatic eruptions and during transport in pyroclastic density currents.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000701> "volcanic ash"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000701> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_02000090> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002353> <http://purl.obolibrary.org/obo/ENVO_01000634>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000701> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/CHEBI_30563>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000702> (ash fall process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Volcanic_ash") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000702> "An ash fall process is a process in which volcanic ash formed during an explosive volcanic eruption, phreatomagmatic eruption, or during material transport in pyroclastic density currents is pulled towards the planetary surface by gravity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000702> "environmental_hazards")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000702> "ash fall process"@en)
