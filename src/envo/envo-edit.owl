AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Hypersaline_lake") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001020> "A lake which is primarily composed of water with a concentration of dissolved salts greater than that of ocean water.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001020> "hypersaline lake"@en)
