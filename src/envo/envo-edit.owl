AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001109> "Kármán vortex street")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001109> "von Kármán vortex street")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001109> "These vortices are responsible for such phenomena as the \"singing\" of suspended telephone or power lines, and the vibration of a car antenna at certain speeds.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001109> "Karman vortex street"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001109> <http://purl.obolibrary.org/obo/ENVO_01001479>)
