AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001633> "Examples include the release of pesticies and/or antibiotic-laden animal waste into water bodies.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001633> "agricultural pollution"@en)
