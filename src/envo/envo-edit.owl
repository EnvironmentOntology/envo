# Class: <http://purl.obolibrary.org/obo/ENVO_03520007> (snow crystal)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://www.snowcrystals.com/science/science.html>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.athropolis.com/arctic-facts/fact-snow-crystal.htm>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.noaa.gov/stories/how-do-snowflakes-form-science-behind-snow>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03520007> "A water ice crystal which is constituted by water molecules aligned in a hexagonal array."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_03520007> <https://orcid.org/0000-0002-2996-719X>)
AnnotationAssertion(Annotation(rdfs:comment "Snow crystals and snowflakes are often noted as synonyms, however, the term \"snowflake\" is generally used more loosely. Some sites mention that snow crystals refer to individual crystals of ice, while the term \"snowflake\" can refer both to an individual crystal of ice and to a bundle of snow crystals. Please see here [https://github.com/EnvironmentOntology/envo/issues/998#issuecomment-685649444]"@en) <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_03520007> "snowflake"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03520007> "snow crystal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03520007> <http://purl.obolibrary.org/obo/ENVO_01000846>)

# Class: <http://purl.obolibrary.org/obo/ENVO_03600000> (cleanroom)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Cleanroom>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03600000> "A building part which is maintained such that the number of foreign particulates within it is controlled."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_03600000> <https://orcid.org/0000-0002-6670-9157>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_03600000> "2021-02-02T21:33:40.901Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_03600000> "clean room"@en)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Cleanroom>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03600000> "The cleanliness level of a cleanroom is quantified by the number of particles per cubic meter at a predetermined molecule measure.

Cleanrooms are designed to maintain extremely low levels of particulates, such as dust, airborne organisms, or vaporized particles. Cleanroons are used in the manufacture of pharmaceutical items, integrated circuits, CRT, LCD, OLED and microLED displays."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03600000> "cleanroom"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03600000> <http://purl.obolibrary.org/obo/ENVO_01000420>)

# Class: <http://purl.obolibrary.org/obo/ENVO_03600001> (chemically contaminated sediment)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Contamination>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03600001> "Sediment which contains some chemical contaminant."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_03600001> "See https://github.com/EnvironmentOntology/envo/issues/1102 for a possible design pattern.

Uses undesirability standard, compared to polluted river's ecological impact standard. What is the relation to ENVO:00002114 'chemically enriched sediment'? Does 'element' in the definition refer to something found in the periosic table (like selenium) or the member of some set, aka an entity?"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_03600001> <https://orcid.org/0000-0002-6670-9157>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_03600001> "2021-04-05T16:38:47.162Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03600001> "chemically contaminated sediment"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_03600001> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00002007> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CHEBI_24431> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_78298>)))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03600001> <http://purl.obolibrary.org/obo/ENVO_00002007>)

