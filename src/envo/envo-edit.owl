# Class: <http://purl.obolibrary.org/obo/ENVO_00000456> (tidewater glacier)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tidewater_glacier#Types_of_glaciers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0003-4808-4736") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_00000456> "A glacier which terminates in a lake or the sea, with terminus either floating or grounded")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_00000456> "envoPolar")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0003-4808-4736") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00000456> "The adjective indicates geographical setting, and not that tides play a role in the mass balance. Typically, tidewater glaciers calve ice to produce icebergs. There are currently issues in the community about the definition of this glacier type: It is undecided whether or not a) a tidewater glacier has to have a grounded terminus and b) whether glaciers terminating in a lake can be considered to be tidewater glaciers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000456> "tidewater glacier")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000456> <http://purl.obolibrary.org/obo/ENVO_00000133>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000456> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/ENVO_00000015>))

