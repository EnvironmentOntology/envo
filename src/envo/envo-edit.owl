AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001728> "squall wind"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001728> <http://purl.obolibrary.org/obo/ENVO_01000793>)

