AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_03000039> "cryoconite holes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_03000039> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03000039> "This class doesn't refer to the site but instead the depression or hole and therefore the adjacency to the cryoconite itself.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03000039> "cryoconite hole"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03000039> <http://purl.obolibrary.org/obo/ENVO_03000048>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03000039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_03000038>))

