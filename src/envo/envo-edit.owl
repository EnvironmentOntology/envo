AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000771> "all-season road")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000771> "permanent road")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000771> "Created for SDGIO, indicator 9.1.1. See #272.")
