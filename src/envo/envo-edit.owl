# Class: <http://purl.obolibrary.org/obo/ENVO_01001636> (insect conservation process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "INTERNAS:WS2") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.awi.de/internas") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.eionet.europa.eu/gemet/concept/15073") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001636> "A biodiversity conservation process during which the variability of insect communities, or parts thereof, is preserved.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001636> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_01001636> "2019-05-29T08:26:59Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001636> "Like other forms of conservation, planned management actions (i.e. preservation, maintenance, sustainable use, recovery, enhancement) of natural resources or of a particular ecosystem is typically employed to halt, reverse or slow-down the die off of insects from the impacts of anthropic exploitation or pollution.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001636> "insect conservation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001636> <http://purl.obolibrary.org/obo/ENVO_01001635>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001636> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PCO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/NCBITaxon_50557>))))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001637> (agricultural specialisation process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "INTERNAS:WS2") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.awi.de/internas") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001637> "An active agri-ecosystem management process during which an ecosystem is modified for the production of one or a small collection of crops or other agricultural products.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001637> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_01001637> "2019-05-29T08:45:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001637> "Spezialisierung der Landwirtschaft"@de)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001637> "Agricultural specialisation is often a means to produce sufficiently large quantities of crops to compete in global markets. Entire landscapes and regions are often dedicated to such production.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001637> "agricultural specialisation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001637> <http://purl.obolibrary.org/obo/ENVO_01001499>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001638> (frost-susceptible soil)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.uspermafrost.org/glossary.php>) Annotation(rdfs:comment "The authoritative definition can be found in the USPA Glossary. Note that the original definition references \"earth materials\" rather than \"soil\".") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001638> "Soil in which segregated ice will form (causing frost heave) under the required conditions of moisture supply and temperature.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01001638> "The label would apply to all soils in which frost can form, however, the definition of this class suggests that ice segregation is a key property that differentiates this type of soil from others.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001638> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_01001638> "2019-05-30T19:07:20Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001638> "frost-susceptible soil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001638> <http://purl.obolibrary.org/obo/ENVO_00001998>)

