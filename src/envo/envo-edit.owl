AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105003> <https://orcid.org/0000-0002-2996-719X>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105003> <https://orcid.org/0000-0003-1072-8081>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105003> <https://orcid.org/0000-0002-8166-0486>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105003> "2021-04-27T09:45:29Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_06105003> "envoPlastics"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105003> "thermoplastic material"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105003> <http://purl.obolibrary.org/obo/ENVO_00010483>)

