# Class: <http://purl.obolibrary.org/obo/ENVO_03501314> (food production environmental monitoring zone 1)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.fda.gov/media/102633/download>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03501314> "An object aggregate which comprises objects whose surfaces are in contact with food during its processing in a food production facility"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_03501314> <https://orcid.org/0000-0002-5192-7047>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_03501314> "2021-03-15T04:00:01.750Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_03501314> "Zone 1"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_03501314> "environmental monitoring zone 1"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03501314> "This can be axiomatised with \"'has part' min 1 'food contact surface'\" . This can also have the axiom \"'part of' some 'food production environmental monitoring zone'\""@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03501314> "food production environmental monitoring zone 1"@en)
