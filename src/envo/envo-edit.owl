# Class: <http://purl.obolibrary.org/obo/ENVO_03000127> (acid rainfall)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Acid_rain") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03000127> "A water-based rainfall process during which water droplets with increased acidity fall towards a planetary surface.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/ENVO_03000127> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/ENVO_03000127> "http://orcid.org/0000-0002-3410-4655")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/ENVO_03000127> "https://orcid.org/0000-0002-3884-3420")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_03000127> "acid rain")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03000127> "On Earth, the acidity of raindrops is typically increased through interactions of water molecules with sulfur dioxide or nitrogen oxide, released into the atmosphere by natural or anthropogenic processes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03000127> "acid rainfall"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03000127> <http://purl.obolibrary.org/obo/ENVO_01000830>)
