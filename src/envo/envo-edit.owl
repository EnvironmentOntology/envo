AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://oceanservice.noaa.gov/facts/coral_bleach.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000852> "An environmental process in which coral expels the symbiotic algae living in its tissue as a result of stress, causing the coral to turn white.")
