AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001853> "periglacial"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001853> <http://purl.obolibrary.org/obo/PATO_0000140>)
