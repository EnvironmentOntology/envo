AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.doi.org/10.1126/science.1155495") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000822> "A planetary part which is exposed, at least periodically, to light.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000822> "photosphere")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000822> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000822> "In some literature, the term photosphere is used; however, this is more correctly reserved for a part of a star.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000822> "planetary photic zone"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000822> <http://purl.obolibrary.org/obo/ENVO_01000813>)
