# Class: <http://purl.obolibrary.org/obo/ENVO_06105272> (loamy sand)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105272> "Soil which is primarily composed of sand with silt and clay in progressively smaller proportions."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105272> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105272> "2021-12-26T22:01:51Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105272> "Some authorities consider this a soil type, composed of 70-86% of sand, 0-30% of silt and 0-15% of clay. Others consider this a soil material that contains at the upper limit 85 to 90% sand, and the percentage of silt plus 1.5 times the percentage of clay is not less than 15, at the lower limit it contains not less than 70 to 85% sand, and the percentage of silt plus twice the percentage of clay does not exceed 30."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105272> "loamy sand"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105272> <http://purl.obolibrary.org/obo/ENVO_01000017>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105272> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_00002258>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105273> (fine sand)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105273> "Sand which is composed primarily of fine particles."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105273> <http://orcid.org/0000-0002-2627-0696>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105273> "2021-12-26T22:04:18Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105273> "Thresholds for what particle size is considered \"fine\" vary by region and authority, as well as the tolerance for proportions of other particle sizes."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105273> "fine sand"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105273> <http://purl.obolibrary.org/obo/ENVO_01000017>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105274> (sandy loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105274> "Loam which has a high proportion of sand in its composition."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105274> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105274> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105274> "2021-12-26T22:08:11Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.fao.org/fishery/docs/CDrom/FAO_Training/FAO_Training/General/x6706e/x6706e06.htm") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105274> "Some authorities consider sandy loam to be a soil composed of 50-70% sand, 0-50% silt, and 0-20% clay. Others, a soil material that contains either 20% or less clay, with a percentage of silt plus twice the percentage of clay that exceeds 30, and 52% or more sand; or less than 7% clay, less than 50% silt, and between 43% and 52% sand."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105274> "sandy loam"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105274> <http://purl.obolibrary.org/obo/ENVO_00002258>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105274> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/ENVO_01000017>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105275> (silty loam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105275> "Loam which has a high proportion of silt in its composition."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105275> <https://orcid.org/0000-0002-4366-3088>)
