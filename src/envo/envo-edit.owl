AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_00002003> "feces material")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_00002003> "droppings")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_00002003> "frass")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_00002003> "pellet")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00002003> "ENVO bodily fluid classes differ from UBERON's treatment of bodily fluids. UBERON refers to the substance itself (\"S\"). We assert that UBERON's classes are the primary compositional component of the terms in ENVO (\"S material\"). Use of the ENVO terms is typically recommended when you wish to indicate that there may be other materials intermixed with S.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00002003> "This is distinct from classes such as http://purl.obolibrary.org/obo/UBERON_0001988 in that it refers to the environmental material composed primarily of feces rather than 'just' feces.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00002003> "fecal material")
