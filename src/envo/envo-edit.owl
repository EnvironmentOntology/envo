AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000328> "A dome swamp is a swamp which occurs in a depression where deeper waters at the centre of the swamp allow  trees to grow taller relative to those in shallower regions of the depression. This creates a dome-like shape.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000328> "The logical def should be improved with the idea of a vegetation unit growing in a depression expressed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000328> "dome swamp")
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000328> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00000233> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_01001307> <http://purl.obolibrary.org/obo/ENVO_00000309>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000328> <http://purl.obolibrary.org/obo/ENVO_00000233>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000329> (cypress dome)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000329> "A cypress dome swamp is a dome swamp which has a plant community dominated by Cupressaceae, often swamp cypresses. Swamp cypresses typically belong to the genus Taxodium or the species Glyptostrobus pensilis and Actinostrobus pyramidalis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000329> "cypress dome swamp")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000329> "Requires import of some taxonomy for differentia")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000329> "cypress dome")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000329> <http://purl.obolibrary.org/obo/ENVO_01000328>)

