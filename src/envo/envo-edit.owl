# Class: <http://purl.obolibrary.org/obo/ENVO_01001860> (wind gust)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://glossary.ametsoc.org/wiki/Gust>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Wind_gust>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001860> "An atmospheric wind which 1) has an increased rate relative to other winds in the same region and 2) is followed by a lull.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001860> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001860> "2020-05-19T21:47:51Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01001860> "gust")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://glossary.ametsoc.org/wiki/Gust>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001860> "According to U.S. weather observing practice, gusts are reported when the peak wind speed reaches at least 16 knots and the variation in wind speed between the peaks and lulls is at least 9 knots. The duration of a gust is usually less than 20 seconds.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001860> "wind gust"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001860> <http://purl.obolibrary.org/obo/ENVO_01000793>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001861> (shortwave radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Shortwave_radiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001861> "An electromagnetic radiation process during which radiant energy with wavelengths in the visible, near-ultraviolet, or near-infrared spectra is realised.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001861> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001861> "2020-05-19T22:14:12Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001861> "short-wave radiation")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Shortwave_radiation>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001861> "There is no standard cut-off for the near-infrared range; therefore, the shortwave radiation range is also variously defined. It may be broadly defined to include all radiation with a wavelength of 0.1 micrometers and 5.0 micrometers or narrowly defined so as to include only radiation between 0.2 micrometers and 3.0 micrometers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001861> "shortwave radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001861> <http://purl.obolibrary.org/obo/ENVO_01001026>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001864> (photosynthetically active radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Photosynthetically_active_radiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001864> "Electromagnetic radidation which involves radiant energy in a spectral range (wave band) between 400 to 700 nanometers, that photosynthetic organisms are able to use in the process of photosynthesis.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001864> <https://orcid.org/0000-0002-4366-3088>)
