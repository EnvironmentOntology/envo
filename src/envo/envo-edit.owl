# Class: <http://purl.obolibrary.org/obo/ENVO_01000824> (exorheic lake)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Open_and_closed_lakes") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000824> "A lake from which water constantly flows out of under almost all climatic circumstances, maintaining low concentrations of dissolved solid relative to endorheic lakes.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000824> "open lake")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000824> "exorheic lake"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000824> <http://purl.obolibrary.org/obo/ENVO_00000020>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000824> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002011>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000825> (eaves)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Eaves") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000825> "A part of a building roof which overhangs the face of a wall and, normally, projects beyond the side of a building.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000825> "The primary function of the eaves is to keep rain water off the walls and to prevent the ingress of water at the junction where the roof meets the wall. The secondary function is to control solar penetration; the eaves overhang can be designed to adjust the building's solar heat gain to suit the local climate, the latitude and orientation of the building, refer to passive solar building design. The eaves overhang may also shelter openings to ventilate the roof space.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000825> "eaves"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000825> <http://purl.obolibrary.org/obo/ENVO_01000420>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000826> (open eaves)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-07-145237-3") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://encyclopedia2.thefreedictionary.com/Open+eaves") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000826> "Overhanging eaves where the rafters and underside of the roof are visible from below.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000826> "open eaves"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000826> <http://purl.obolibrary.org/obo/ENVO_01000825>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000827> (closed eaves)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-07-145237-3") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://encyclopedia2.thefreedictionary.com/Closed+eaves") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000827> "Eaves in which projecting roof members are not visible, being closed from view by boarding.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000827> "closed eaves"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000827> <http://purl.obolibrary.org/obo/ENVO_01000825>)

