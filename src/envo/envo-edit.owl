SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000542> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_02000200> <http://purl.obolibrary.org/obo/CHEBI_25812>))

