AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003019> "Energy which inheres in a wave and is realised during its propagation."@en)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://purl.obolibrary.org/obo/ENVO_01003019> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003019> "wave energy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003019> <http://purl.obolibrary.org/obo/ENVO_2000015>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01003020> (fiat part of an astronomical object)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003020> "A part of an environmental system whose boundaries are determined by fiat."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003020> "Subclasses of this class have fiat (and only fiat) boundaries - that is, boundaries which are determined by human consensus or opinion rather than (and sometimes in contrast to) well-defined physical discontinuities. We distinguish these from entities that have fuzzy or hard to define boundaries that do overlap some form of physical discontinuity."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003020> "fiat part of an astronomical object"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003020> <http://purl.obolibrary.org/obo/BFO_0000024>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003020> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01000804>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01003021> (area of high atmospheric pressure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01003021> "A gaseous part of an atmosphere in which gases have increased atmospheric pressure."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01003021> "Air is not specified directly (although the definition subsumes air masses) to allow for other forms of low pressure areas in planetary atmospheres.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01003021> "area of high atmospheric pressure"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003021> <http://purl.obolibrary.org/obo/ENVO_01001645>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01003021> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000797> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001576>))))

