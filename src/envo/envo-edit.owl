AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ENVO_00002017> "ENVO")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_00002017> "ENVO:00002017")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00002017> "metamorphic rock")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00002017> <http://purl.obolibrary.org/obo/ENVO_00001995>)

