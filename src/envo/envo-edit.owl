SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000457> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/ENVO_00000182>))

# Class: <http://purl.obolibrary.org/obo/ENVO_00000458> (valley glacier)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tidewater_glacier#Types_of_glaciers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0003-4808-4736") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_00000458> "A glacier which 1) flows for all or most of its length within the walls of a valley, in consequence having a distinct tongue and a well-defined outline and 2) descends from either high mountains, from an ice cap on a plateau, or from an ice sheet.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_00000458> "https://en.wikipedia.org/wiki/Valley_glacier")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0003-4808-4736") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_00000458> "These glaciers typically flow down pre-existing valleys and have ice-free slopes overlooking the glacier surface.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000458> "valley glacier")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000458> <http://purl.obolibrary.org/obo/ENVO_00000133>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000458> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_01001307> <http://purl.obolibrary.org/obo/ENVO_00000100>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000458> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/ENVO_00000100>))

