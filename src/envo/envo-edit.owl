# Class: <http://purl.obolibrary.org/obo/ENVO_01000571> (cold-blast paraffin lantern)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Kerosene_lantern") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000571> "A cold-blast paraffin lantern is a tubular paraffin lantern which collects cool air from around the top of the lantern globe and circulates it, through metal tubes, to the burning wick.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000571> "cold-blast paraffin lantern"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000571> <http://purl.obolibrary.org/obo/ENVO_01000568>)

