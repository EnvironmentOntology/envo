# Class: <http://purl.obolibrary.org/obo/ENVO_03501315> (food production environmental monitoring zone 2)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.fda.gov/media/102633/download>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_03501315> "An object aggregate which comprises objects whose surfaces are not in contact with food during its processing, but which are in close proximity to those in food production environmental monitoring zone 1."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_03501315> <https://orcid.org/0000-0002-5192-7047>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_03501315> "2021-03-15T04:00:01.750Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_03501315> "Zone 2"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_03501315> "This can be axiomatised with \"'has part' min 1 'food contact surface'\" . This can also have the axiom \"'part of' some 'food production environmental monitoring zone'\". The threshold for \"close proximity\" can vary based on local or national legislation. 'adjacent to' axioms may also be used for neighbouring zones."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_03501315> "food production environmental monitoring zone 2"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03501315> <http://purl.obolibrary.org/obo/BFO_0000027>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_03501315> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_03501313>))

# Class: <http://purl.obolibrary.org/obo/ENVO_03501316> (food production environmental monitoring zone 3)

