SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000678> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002427> <http://purl.obolibrary.org/obo/ENVO_01001093>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000679> (megathrust earthquake)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Adapted from URL:http://www.britannica.com/science/earthquake-geology") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Earthquake") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000679> "A megathrust earthquake is a tectonic earthquake which occurs at subduction zones at destructive plate boundaries (convergent boundaries). These interplate earthquakes are the planet's most powerful, with moment magnitudes that can exceed 9.0.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000679> "environmental_hazards")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000679> "megathrust earthquake"@en)
