AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Bus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000611> "A bus is a road vehicle designed to carry many passengers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000611> "bus"@en)
