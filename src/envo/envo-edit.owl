AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/11493/144275.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Land_use") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/en/concept/7143") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001446> "A planned environmental usage process during which an environment supports the settlement and dwelling of a community of humans.")
