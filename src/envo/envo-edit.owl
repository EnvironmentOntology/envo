SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_00001999>))

