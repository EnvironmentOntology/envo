# Class: <http://purl.obolibrary.org/obo/ENVO_01000736> (phacolith)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Adapated from https://en.wikipedia.org/wiki/Phacolith") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000736> "A phacolith is an intrusion parallel to the bedding plane or foliation of folded country rock. More specifically, it is a typically lens-shaped intrusion that occupies either the crest of an anticline or the trough of a syncline.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000736> "phacolith"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000736> <http://purl.obolibrary.org/obo/ENVO_01000525>)

