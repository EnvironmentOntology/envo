AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000851> "envoPolar")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000851> "methane clathrate"@en)
