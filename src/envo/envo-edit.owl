AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105241> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105241> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105241> "2021-12-22T17:12:04Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105241> "soil drainage"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105241> <http://purl.obolibrary.org/obo/ENVO_01003009>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105241> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000066> <http://purl.obolibrary.org/obo/ENVO_00001998>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105241> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/ENVO_00002006>))

# Class: <http://purl.obolibrary.org/obo/ENVO_06105242> (basic cation exchange capacity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://extension.uga.edu/publications/detail.html?number=C1040") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105242> "A cation exchange capacity which inheres in an environmental material by virtue of the material's ability to adsorb basic exchangeable cations."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105242> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105242> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105242> "2021-12-22T17:32:00Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105242> "BS"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105242> "The basic cation exchange capacity is often expressed as the percentage of the total exchangeable cations which are basic, known as the percentage base saturation. The percentage base saturation is expressed as follows: %BS = [(Ca2+ + Mg2+ + K+)/CEC] × 100"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105242> "basic cation exchange capacity"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105242> <http://purl.obolibrary.org/obo/ENVO_06105240>)

# Class: <http://purl.obolibrary.org/obo/ENVO_06105265> (net shortwave radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://disc.gsfc.nasa.gov/hydrology/data-holdings/parameters/net_shrtwave_rad.shtml") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_06105265> "Energy which has been absorbed by an astronomical body or its parts following that body's irradiation by shortwave radiation from a star."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_06105265> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_06105265> <https://orcid.org/0000-0001-6284-4821>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105265> "2021-12-23T03:51:41Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105265> "absorbed shortwave radiation"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105265> "Despite the label, this is not a shortwave radiation process, but the energy that is absorbed from one. This term is used to describe, e.g., the energy absorbed from insolation and stored by the Earth. Gross shortwave radiation would also include shortwave radiation reflected back into space by clouds, aerosols, and solid surfaces with high albedo."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105265> "net shortwave radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105265> <http://purl.obolibrary.org/obo/ENVO_2000015>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105265> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/ENVO_01001211>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_06105265> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/ENVO_01000799>))

