AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "USGS:SDTS") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_00000499> "swale")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000499> "trough")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000499> <http://purl.obolibrary.org/obo/ENVO_00000309>)

