EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001193> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000636> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002006>)))
