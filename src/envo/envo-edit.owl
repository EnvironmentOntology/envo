AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01001022> "This class is to be filled by inference.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001022> "natural lake"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01001022> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00000020> ObjectComplementOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002354> <http://purl.obolibrary.org/obo/ENVO_01000952>))))
