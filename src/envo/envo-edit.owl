AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000658> "A settlement with a high density of buildings and inhabitants.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000658> "See also: http://www.ecotope.org/anthromes/v1/guide/urban/12_dense_settlements/default.aspx")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000658> "The thresholds for what makes a settlment \"dense\" can be determined as needed. If there is a specific threshold that should be added to ENVO, please make a new class request.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000658> "dense settlement"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000658> <http://purl.obolibrary.org/obo/ENVO_01001829>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000659> (igneous intrusion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Volcanism") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000659> "An igneous intrusion is a mass of rock and minerals formed when magma cools, solidifies, and undergoes fractional crystallisation without reaching the surface.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000659> "Subclasses of this class will be created by inference.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000659> "\"Intrusion\" can refer to the solidified mass or the molten rock.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000659> "igneous intrusion"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/ENVO_01000659> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000525> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_00002013>)))
