AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_00000511> "ENVO:00000511")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000511> "blanket bog")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000511> <http://purl.obolibrary.org/obo/ENVO_00000044>)

