# Class: <http://purl.obolibrary.org/obo/ENVO_01001857> (outgoing longwave radiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Outgoing_longwave_radiation>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001857> "An infrared radiation process which 1) transmits radiant energy has wavelengths between 3.0 and 100 μm, 2) is emitted from a planet and its atmosphere out to space in the form of thermal radiation.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001857> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001857> "2020-05-18T21:55:44Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001857> "outgoing long-wave radiation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001857> "up-welling long-wave radiation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/ENVO_01001857> "terrestrial long-wave flux")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001857> "In the Earth's climate system, long-wave radiation involves processes of absorption, scattering, and emissions from atmospheric gases, aerosols, clouds and the surface.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001857> "outgoing longwave radiation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001857> <http://purl.obolibrary.org/obo/ENVO_21001214>)

