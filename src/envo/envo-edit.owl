AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_00000404> "composite volcano")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_00000404> "ENVO:00000404")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000404> "stratovolcano")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000404> <http://purl.obolibrary.org/obo/ENVO_00000247>)

