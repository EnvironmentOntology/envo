AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_06105107> "海洋廢棄物"@zh)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_06105107> "envoPlastics")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105107> "Very large objects that are discarded are typically considered \"debris\", but this term is loosely defined and there are no standard size classifications which can be used to distinguish debris from litter."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105107> "marine anthropogenic litter"@en)
