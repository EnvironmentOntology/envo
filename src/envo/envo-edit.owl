# Class: <http://purl.obolibrary.org/obo/ENVO_01000617> (lentic water body)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000617> "A lentic water body is a water body in which the accumulated water, in its totality, has very little to no directed flow.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000617> "lentic water body"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000617> <http://purl.obolibrary.org/obo/ENVO_00000063>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000618> (lotic water body)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000618> "A lotic water body is a water body in which the accumulated water, in its totality, is flowing.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000618> "lotic water body"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000618> <http://purl.obolibrary.org/obo/ENVO_00000063>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000619> (closed ecological system)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Closed_ecological_system") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000619> "A closed ecological system is a vivarium which does not rely on matter exchange with any part outside the system.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000619> "This class refers to strictly sealed enclosures such as Biosphere 2 (https://en.wikipedia.org/wiki/Biosphere_2), rather than vivaria which allow matter exchange with external environmental systems.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000619> "closed ecological system"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000619> <http://purl.obolibrary.org/obo/ENVO_00010622>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000620> (mesocosm)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Mesocosm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000620> "A mesocosm is a vivarium that is embedded within a natural environment and is used to place a relatively small part of that environment under experimental control for the purposes of scientific investigation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000620> "mesocosm"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000620> <http://purl.obolibrary.org/obo/ENVO_00010622>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000621> (microcosm)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Microcosm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000621> "A microcosm is a vivarium within which a simple ecosystem is artificially established and used to simulate and predict the behaviour of natural ecosystems under controlled conditions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000621> "microcosm"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000621> <http://purl.obolibrary.org/obo/ENVO_00010622>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000622> (vaporisation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000622> "Vaporisation of an element or compound is process whereby that element or compound undergoes a phase transition from the liquid to vapor.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000622> "vaporization")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000622> "Note that a vapor describes an element or compound in the gas phase at a temperature lower than its critical point,")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000622> "vaporisation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000622> <http://purl.obolibrary.org/obo/ENVO_03000043>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000622> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002233> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00010483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001548>))))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000622> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00010483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001547>))))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000623> (boiling)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Boiling") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000623> "Boiling is a form of vaporisation which occurs when a liquid is heated to a temperature at which the vapor pressure of the liquid is equal to the pressure exerted on the liquid by the surrounding environmental pressure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000623> "boiling"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000623> <http://purl.obolibrary.org/obo/ENVO_01000622>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000624> (hydrological condensation process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Condensation") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000624> "Hydrological condensation is a process in which atmospheric water vapour undergoes a phase transition from the gas phase to the liquid phase.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000624> "condensation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000624> "envoAtmo")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000624> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000624> "\"process\" is included in the label to make it clear that we are not referring to the condensed material (e.g. water droplets, window fog)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000624> "hydrological condensation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000624> <http://purl.obolibrary.org/obo/ENVO_01000724>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000624> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002233> <http://purl.obolibrary.org/obo/ENVO_01000268>))
