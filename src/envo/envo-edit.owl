SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000487> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/ENVO_01000474>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000488> (wooden building floor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000488> "A wooden building floor is a building floor that is composed primarily of wood.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01000488> "ORCID:0000-0002-4366-3088")
