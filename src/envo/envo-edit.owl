AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_21001215> "visible spectrum radiation")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_21001215> <http://purl.obolibrary.org/obo/ENVO_01001026>)

