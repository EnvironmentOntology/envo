AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Drain_(plumbing)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000924> "An artificial channel which transports unwanted water or waste liquids away from their source, either to a more useful area, a receptacle, or into sewers or stormwater mains as waste discharge to be released or processed.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000924> "drain")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000924> "drainage channel")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000924> "plumbing drain"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000924> <http://purl.obolibrary.org/obo/ENVO_00000121>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000925> (abattoir)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Slaughterhouse") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000925> "A facility in which non-human animals are slaughtered and processed for human consumption.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000925> "slaughter plant"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000925> "slaughterhouse")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000925> "butchery"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000925> "meat processing building")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000925> "abattoir"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000925> <http://purl.obolibrary.org/obo/ENVO_00003861>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000926> (knackery)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Slaughterhouse") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000926> "A facility in which non-human animals are slaughtered and processed, but not for human consumption.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000926> "knacker's yard")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000926> "Animals killed in knacker's yards are not fit for human consumption or can no longer be used to perform work.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000926> "knackery"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000926> <http://purl.obolibrary.org/obo/ENVO_00003861>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000927> (day care building)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Day_care") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000927> "A building which is used to care for a human child during the working day by a person, outside the child's immediate family, other than that child's legal guardians.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01000927> <https://orcid.org/0000-0002-1107-9135>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000927> "child care building")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000927> "daycare building"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000927> "This is a kind of day care facility. A facility need not be a building.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000927> "day care building"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000927> <http://purl.obolibrary.org/obo/ENVO_01001222>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000928> (fish processing building)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fish_factory") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000928> "A building in which fish are subject to a series of operations to prepare them for human consumption.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000928> "fish factory")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000928> "This is a kind of fish processing facility. Facilities need not be buildings, factory ships may be considered fish processing facilities.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000928> "fish processing building"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000928> <http://purl.obolibrary.org/obo/ENVO_00003863>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000929> (mushroom environment)

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000929> "An environment determined by the presence of a mushroom.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000929> "mushroom environment"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000929> <http://purl.obolibrary.org/obo/ENVO_2100000>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000930> (ecological corridor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.eionet.europa.eu/gemet/concept/10510") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.eionet.europa.eu/gemet/concept/3756") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000930> "An ecosystem which bridges two or more adjoining ecosystems and through which organisms may move or propagate.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000930> "animal corridor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000930> "green corridor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000930> "habitat corridor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000930> "wildlife corridor")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000930> "Ecological corridors may or may not provide habitats for the organisms which move through them. They serve to mitigate the effects of habitat fragmentation by allowing genetic exchange between populations that would otherwise be separated by, e.g., human activity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000930> "ecological corridor"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000930> <http://purl.obolibrary.org/obo/ENVO_01001110>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000931> (migration path)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000931> "An ecological corridor through which organisms move during a migration process.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000931> "Should be axiomatised with PCO's migration process once it is released.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000931> "migration corridor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000931> "migratory route")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000931> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000931> "This term refers to the ecosystem(s) the organisms traverse, rather than the spatial track they cover. The latter is better placed in a geospatial ontology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000931> "migration path"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000931> <http://purl.obolibrary.org/obo/ENVO_01000930>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000932> (nursing home)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Nursing_home_care") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000932> "A building in which nursing aides and skilled nurses provide care and treatment to residents who have significant difficulty coping with the required activities of daily living.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000932> "This class should be linked to SDGIO.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "intermediate care facility")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "long-term care facility")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "old people's home"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "skilled nursing facility")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "care home")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "convalescent home")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000932> "rest home")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000932> "nursing home"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000932> <http://purl.obolibrary.org/obo/ENVO_03501134>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000933> (residential building)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000933> "A human house which serves as a long-term shelter for its inhabitants and within which they store personal property.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000933> "This is under \"human house\" due to the broad definition of \"house\".")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000933> "This term is not to be used for hotels, hostels, inns and the like, which provides shorter-term stays.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000933> "residential building"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000933> <http://purl.obolibrary.org/obo/ENVO_01000418>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000934> (restaurant)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Restaurant") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000934> "A building within which food and drink are prepared and served to customers in exchange for money or other goods and/or services.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000934> "eatery")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000934> "restaurant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000934> <http://purl.obolibrary.org/obo/ENVO_01001222>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000935> (campground)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Campsite") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000935> "A part of an ecosystem which may be or has been used for one or more overnight stays by humans sheltering in tents, camper vans, caravans, or improvised shelters.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000935> "This is a very ambiguous term with wide-ranging usage patterns across cultural groups and regions.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000935> "camping ground")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000935> "camping pitch")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000935> "camping site")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000935> "campsite")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000935> "campground"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000935> <http://purl.obolibrary.org/obo/ENVO_00000002>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000936> (dedicated campground)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Campsite") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000936> "A campground which has been modified by humans to provide and maintain facilities for camping such as fire pits, road access, latrines, and garbage bins.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000936> "dedicated campground"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000936> <http://purl.obolibrary.org/obo/ENVO_01000935>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000937> (impromptu campground)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Campsite") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000937> "A campground which has no pre-existing facilities installed or maintained by humans, usually found outside of anthropised ecosystems.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000937> "impromptu campground"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000937> <http://purl.obolibrary.org/obo/ENVO_01000935>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000938> (hot tub)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Hot_tub") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000938> "A manufactured product which may hold a volume of heated water suitable for one or more humans to bathe in, usually for the purposes of hydrotherapy or pleasure.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ENVO_01000938> "spa")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/ENVO_01000938> "Jacuzzi")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000938> "hot tub"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000938> <http://purl.obolibrary.org/obo/ENVO_00003074>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000939> (time crystal)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Time_crystal") Annotation(rdfs:comment "https://dx.doi.org/10.1038/543164a") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000939> "An open system in non-equilibrium with its environment that exhibits time translation symmetry breaking.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000939> "space-time crystal")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000939> "While the usage of the term is still debated, the general idea is that time crystals (which have been made using ytterbium ions and defect-bearing diamonds) break temporal symmetry analogously to how mineral crystal break spatial symmetry. While spatial crystals are inhomogeneous in space (vs a gas, which is distributed evenly) due to the ordering of their atoms, the properties of atoms in a time crystal are inhomogeneous in the time dimension.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000939> "time crystal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000939> <http://purl.obolibrary.org/obo/ENVO_00010483>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000940> (fissure water)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/EnvironmentOntology/envo/issues/466") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000940> "Water which is partially contained within a fissure or a geological fracture.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000940> "The axiomatisation should be more tuned to the site within the fissure.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000940> "fracture water")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000940> "While containment is often enough to classify this subtype of water, it is expected that the water's composition is altered by contact with the solid material bounding the fissure's site.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000940> "fissure water"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000940> <http://purl.obolibrary.org/obo/ENVO_00002006>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000940> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ENVO_01001307> <http://purl.obolibrary.org/obo/ENVO_01000667>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000941> (planetary subsurface zone)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000941> "Regions of a planet which are not exposed to the planet's atmosphere or space, often comprising parts of one or more planetary structural layers.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000941> "planetary subsurface zone"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000941> <http://purl.obolibrary.org/obo/ENVO_01001776>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000941> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/ENVO_01000639>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000941> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/ENVO_01000324>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000942> (continental subsurface zone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/EnvironmentOntology/envo/issues/466") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000942> "A region which overlaps parts of one or more planetary structural layers which are located below a continental landmass.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000942> "We may have to soften dependence on planetary structural layers as some planets haven't differentiated by density.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000942> "continental subsurface zone"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000942> <http://purl.obolibrary.org/obo/ENVO_01000941>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000942> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/ENVO_01000748>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000942> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002220> <http://purl.obolibrary.org/obo/ENVO_01000635>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000943> (vegetated hill)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000943> "A hill which has a surface that is partially or wholly covered by plant communities.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000943> "This class will be axiomatised to coordinate with the 'vegetated area' class.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000943> "vegetated hill"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000943> <http://purl.obolibrary.org/obo/ENVO_00000083>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000944> (microplastic particle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Microplastics") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://marinedebris.noaa.gov/file/2192/download?token=5dvqb-YY") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000944> "A piece of plastic which has a diameter less than five millimetres.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_01000944> <https://orcid.org/0000-0002-2996-719X>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_01000944> <https://orcid.org/0000-0002-8166-0486>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/contributor> <http://purl.obolibrary.org/obo/ENVO_01000944> <https://orcid.org/0000-0003-1072-8081>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000944> "microplastic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000944> "envoPlastics")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://www.gesamp.org/publications/guidelines-for-the-monitoring-and-assessment-of-plastic-litter-in-the-ocean>) rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000944> "This classification is based on the thresholds detailed in GESAMP report # 99 on recommendation from the SDG 14 indicator team. While the definition is in accordance with the common use of this term (as per GESAMP report # 99), alternative size classifications exist. Alternative classifications are a piece of plastic which is between 1 and 5 millimetres in diameter, a piece of plastic which has a diameter less than 1 millimetre, or a piece of plastic which has a diameter greater than 330 micrometres. The use of the word diameter in this case was understood to mean the generalised form of diameter, i.e. the largest distance between two points belonging to an object."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000944> "microplastic particle"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000944> <http://purl.obolibrary.org/obo/ENVO_01000776>)

