AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000893> "According to the NLCD 2011, at least 20% of these areas are covered by forest or shrubland vegetation.  Such thresholds - which are themselves fuzzy - are not strictly asserted in this definition.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000893> "area of woody wetland"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000893> <http://purl.obolibrary.org/obo/ENVO_01001305>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000893> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01000324>))
