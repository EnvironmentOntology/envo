SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000025> <http://purl.obolibrary.org/obo/ENVO_01000024>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01000026> (marine bathyal zone biome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-444-82619-0") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ORCID:0000-0002-4366-3088") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000026> "The marine bathyal zone biome comprises regions of the marine benthic biome between approximately 200 m and 3000 m depth. This zone generally coincides with the continental slope.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01000026> "ORCID:0000-0002-4366-3088")
