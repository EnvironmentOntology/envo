# Class: <http://purl.obolibrary.org/obo/ENVO_01001876> (graupel)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-4808-4736>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001876> "Snow which is composed of heavily rimed particles typically 2 to 5 millimeters in diameter (0.1 to 0.2 inch)."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01001876> "Subclass by shape into conical, hexagonal, and lump (irregular) graupel. Mark Parsons notes that the formational processes may be a source of useful differentia to distinguish graupel from other snow types."@en)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001876> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_01001876> "2020-07-22T19:10:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ENVO_01001876> <http://sweetontology.net/phenAtmoPrecipitation/Graupel>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01001876> "snow pellets"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001876> "Often indistinguishable from very small soft hail except for the size convention that hail must have a diameter greater than 5 mm. Sometimes distinguished by shape into conical, hexagonal, and lump (irregular) graupel."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001876> "graupel"@en)
