AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000719> "snowmelt"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000719> <http://purl.obolibrary.org/obo/ENVO_01000720>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000719> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002233> <http://purl.obolibrary.org/obo/ENVO_01000406>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000719> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <http://purl.obolibrary.org/obo/ENVO_00002011>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000720> (hydrological melting process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000720> "A melting process during which water-based ice, snow, or other solid phase water transitions into a liquid phase.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000720> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000720> "Here, we've nexted melting within thawing as one approach to resolve the semantics of thawing of ice-free materials. Expert group revision is requried.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000720> "hydrological melting process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000720> <http://purl.obolibrary.org/obo/ENVO_01000723>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000720> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01001611>))
