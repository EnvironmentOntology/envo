# Class: <http://purl.obolibrary.org/obo/ENVO_01001484> (fire whirl)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fire_whirl") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001484> "A fire whirl is a whirlwind induced by the contraction and rotation of intense, rising heat and turbulent, eddying air masses resulting from a large fire and made up of a core of burning matter surrounded by a rotating pocket of air."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01001484> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_01001484> "2018-10-04T16:59:07Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001484> "fire devil"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001484> "fire swirl"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01001484> "fire tornado"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01001484> "fire twister"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01001484> "firenado"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001484> "Note that this not a sublcass of \"tornado\": this is a different phenomenon formed as a result of  convection induced by fire."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001484> "fire whirl"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001484> <http://purl.obolibrary.org/obo/ENVO_01000755>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001484> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_00010483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0015022>))))
