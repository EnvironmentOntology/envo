AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ENVO_00000492> "ENVO:00000492")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000492> "resequent stream")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000492> <http://purl.obolibrary.org/obo/ENVO_00000023>)

