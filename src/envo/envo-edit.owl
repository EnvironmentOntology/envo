AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "URL:http://mdgs.un.org/unsd/mdg/Metadata.aspx?IndicatorId=0&SeriesId=711") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "URL:http://www.communitascoalition.org/pdf/Communitas_SDSN_Indicators.pdf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Slum") Annotation(rdfs:comment "Definition linked to a UN Habitat report entitled \"What are slums and why do they exist?\" as well as sources from the MDGs and Communitas.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000653> "A slum is a heavily populated urban informal settlement with substandard housing in which households lack any one of the following: access to improved water, access to improved sanitation, sufficient-living area, durability of housing, or security of tenure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000653> "slum"@en)
