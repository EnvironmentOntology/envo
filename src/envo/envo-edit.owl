AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01000524> "latrine shelter")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000524> "dunny")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000524> "privy")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Outhouse") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000524> "\"Outside North America, the term \"outhouse\" refers not to a toilet but to outbuildings in a general sense.\"")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000524> "outhouse")
