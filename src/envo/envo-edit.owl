SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001343> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000066> <http://purl.obolibrary.org/obo/ENVO_01001340>))
