AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/ENVO_06105277> "2021-12-26T22:12:30Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sis.agr.gc.ca/cansis/glossary/t/index.html") Annotation(rdfs:comment "USDA textural classes of soils") rdfs:comment <http://purl.obolibrary.org/obo/ENVO_06105277> "Some authorities consider clay loam to be a soil composed of 20-45% sand, 15-52% silt, and 27 to 40% clay."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_06105277> "clay loam"@en)
