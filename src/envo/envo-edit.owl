# Class: <http://purl.obolibrary.org/obo/ENVO_01000451> (atmospheric carbon dioxide)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000451> "Atmospheric carbon dioxide is an environmental material composed of carbon dioxide in its gaseous form present in an atmosphere.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/ENVO_01000451> "ORCID:0000-0002-4366-3088")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000451> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000451> "This could also be considered a part of an environmental material like air.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000451> "atmospheric carbon dioxide")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000451> <http://purl.obolibrary.org/obo/ENVO_01000797>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000451> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ENVO_01000267>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/CHEBI_16526>)))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000451> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001547>))

