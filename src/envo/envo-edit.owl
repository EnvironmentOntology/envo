AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_00000363> "area designated as a nature reserve")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_00000363> <http://purl.obolibrary.org/obo/ENVO_00000358>)

