AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000299> "This is an interesting class. It's not really a column in the sense of a water column, nor is it a current, exactly. It may also occur in any fluid, gaseous or liquid.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000299> "Taylor column")
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000299> <http://purl.obolibrary.org/obo/ENVO_01001479>)
