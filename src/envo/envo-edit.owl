AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000688> "Usually reserved for large lakes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000688> "lake coast"@en)
