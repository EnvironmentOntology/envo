AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/ENVO_01000757> "FOODON:00001262")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000757> "obsolete fruit"@en)
