AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01000631> "envoPolar")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000631> "On Earth, the major cause of ocean acidification is the update of carbon dioxide from the atmosphere.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000631> "ocean acidification"@en)
