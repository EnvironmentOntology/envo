AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001852> "energy transfer process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001852> <http://purl.obolibrary.org/obo/ENVO_02500000>)

