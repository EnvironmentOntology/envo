AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01001377> "envoEOVs")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ENVO_01001377> "envoMarine")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001377> "sea surface height"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001377> <http://purl.obolibrary.org/obo/PATO_0001687>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001377> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/ENVO_01001581>))

