AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.eionet.europa.eu/gemet/en/concept/6622") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000768> "Forest which originally covered a region before changes in the environment brought about by people. (Source: PHC)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000768> "primary forest"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000768> <http://purl.obolibrary.org/obo/ENVO_01001243>)

