# Class: <http://purl.obolibrary.org/obo/ENVO_01001634> (agricultural landscape diversification process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "INTERNAS:WS2") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://awi.de/internas") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ipbes.net/system/tdf/downloads/pdf/ipbes_4_19_annex_ii_spm_pollination_en.pdf?file=1&type=node&id=28363") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001634> "An active agri-ecosystem management process during which the variability of land use types or the spatial structure of land under agricultural production is increased.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ENVO_01001634> <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ENVO_01001634> "2019-05-29T08:19:55Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ENVO_01001634> "Agrarlandschaftsdiversifizierung"@de)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001634> "This includes the introduction or balancing of cover types such as forests, crops, grassland, or land covered by crop cultivars such as wheat, maize, legumes, vegetables.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001634> "agricultural landscape diversification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001634> <http://purl.obolibrary.org/obo/ENVO_01001499>)

# Class: <http://purl.obolibrary.org/obo/ENVO_01001635> (biodiversity conservation process)

