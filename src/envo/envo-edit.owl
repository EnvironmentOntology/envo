# Class: <http://purl.obolibrary.org/obo/ENVO_01000947> (ecotone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-03-058414-5") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Ecotone") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/EnvironmentOntology/envo/issues/501") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.merriam-webster.com/dictionary/ecotone") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000947> "An envirommental system which bridges two or more biomes and which includes ecological communities which blend these biomes' phylogenetic and phenotypic compositions.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000947> "There are many subtypes of ecotone, some with sharp transitions and others with gradual, patchy transitions between communities. From Wikipedia:Ecotone - The word ecotone was coined from a combination of eco(logy) plus -tone, from the Greek tonos or tension – in other words, a place where ecologies are in tension.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000947> "ecotone"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000947> <http://purl.obolibrary.org/obo/ENVO_01001110>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000947> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/ENVO_00000428>))
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000947> ObjectMinCardinality(2 <http://purl.obolibrary.org/obo/RO_0002180> <http://purl.obolibrary.org/obo/ENVO_00000428>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01000948> (polar tree-line ecotone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tree_line") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/EnvironmentOntology/envo/issues/501") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01000948> "An ecotone which bridges a subpolar coniferous forest biome and a tundra biome.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01000948> "This assumes, of course, that the planet's or planetoid's poles receive less stellar radiation and/or thermal energy than equatorial regions.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ENVO_01000948> "Arctic tree-line ecotone")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01000948> "Major vegetational ecotones such as that between the northern edge of the Boreal Forest in North America (or taiga in Russia) and the arctic tundra, known as the arctic tree-line ecotone, are controlled largely by large-scale airmass contrasts and are sensitive to climatic change, as noted by R. A. Bryson (1966).
Harvey Nichols, Ph.D. , April 23, 2017
Emeritus Professor of Biology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01000948> "polar tree-line ecotone"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000948> <http://purl.obolibrary.org/obo/ENVO_01000953>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01000948> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ENVO_01000180> <http://purl.obolibrary.org/obo/ENVO_01000250>)))

