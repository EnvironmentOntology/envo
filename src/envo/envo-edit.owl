# Class: <http://purl.obolibrary.org/obo/ENVO_01001243> (forest ecosystem)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.fao.org/docrep/017/ap862e/ap862e00.pdf") Annotation(rdfs:comment "https://www1.usgs.gov/csas/nvcs/nvcsGetUnitDetails?elementGlobalId=860217") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001243> "An ecosystem which is determined by communities of plants with a tree growth form and in which members of those communities form continuous or discontinuous regions of canopy cover.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01001243> "The correct usage of FLOPO terms in the axiomatisation needs to be confirmed.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001243> "The definitions of forest can vary greatly, and different classes will be needed to support the major categories. Tree cover alone is not enough to distinguish between forests and plantations. The international definition proposed by the 2010 FAO Forestry Resource Assessment: \"land spanning more than 0.5 ha with trees higher than 5 metres and canopy cover of more than 10 percent, or trees able to reach these thresholds in situ . It does not include land that is predominantly under agricultural or urban land use.\" - FAO.  2010. Global forest resources assessment 2010, Main report, FAO Forestry Paper 163. Rome.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001243> "forest ecosystem"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001243> <http://purl.obolibrary.org/obo/ENVO_01001790>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001243> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01001239>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001244> (cropland ecosystem)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://dx.doi.org/10.1890/070062>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001244> "An ecosystem which 1) is determined by communities of annual crops, perennial woody crops, or by actively tilled land, 2) is primarily used for agricultural activity, and 3) contains no village or larger human settlement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001244> "cropland ecosystem"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001244> <http://purl.obolibrary.org/obo/ENVO_01001790>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001244> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002354> <http://purl.obolibrary.org/obo/ENVO_01000952>))

# Class: <http://purl.obolibrary.org/obo/ENVO_01001245> (woodland ecosystem)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Woodland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ENVO_01001245> "An ecosystem which is determined by communities of plants with a tree growth form and in which members of those communities are spaced sufficiently far apart to allow sunlight to illuminate the understory.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/ENVO_01001245> "The correct usage of FLOPO terms in the axiomatisation needs to be confirmed.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ENVO_01001245> "Woodland understories are often populated with communities of shrubs and herbaceous plants including grasses. There are varying distinctions between woodland and forest, with a large degree of ambiguity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ENVO_01001245> "woodland ecosystem"@en)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001245> <http://purl.obolibrary.org/obo/ENVO_01001790>)
SubClassOf(<http://purl.obolibrary.org/obo/ENVO_01001245> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/ENVO_01001240>))

